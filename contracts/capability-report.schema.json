{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/intune-iac/contracts/1.0.0/capability-report.schema.json",
  "title": "capability-report",
  "description": "Original Appendix B contract. Local validation only; not an official Microsoft schema.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "provider": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "offline_mapping_complete": {
      "type": "boolean"
    },
    "live_qualified": {
      "type": "boolean"
    },
    "execution_authorized": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "source_pointer": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "source_pointer"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "provider",
    "version",
    "offline_mapping_complete",
    "live_qualified",
    "execution_authorized",
    "blockers"
  ],
  "additionalProperties": false
}
