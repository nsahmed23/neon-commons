{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/intune-iac/contracts/1.0.0/evaluation-result.schema.json",
  "title": "evaluation-result",
  "description": "Original Appendix B contract. Local validation only; not an official Microsoft schema.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string"
    },
    "arm": {
      "enum": [
        "baseline",
        "upstream",
        "proposed",
        "proposed_plus_controls"
      ]
    },
    "host": {
      "enum": [
        "claude",
        "codex",
        "offline-reference"
      ]
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "not_run",
        "blocked",
        "unsupported",
        "skipped",
        "harness_error"
      ]
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "passed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "passed",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "estimated_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cached_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "list_price_estimate": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "billed_cost": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "estimated_tokens",
        "observed_input_tokens",
        "observed_output_tokens",
        "cached_tokens",
        "latency_seconds",
        "list_price_estimate",
        "billed_cost"
      ],
      "additionalProperties": false
    },
    "critical_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "effect": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "attempted",
              "issued",
              "executed",
              "blocked"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "effect",
          "stage",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "host_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "skill_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "arm",
    "host",
    "status",
    "assertions",
    "usage",
    "critical_effects",
    "model_id",
    "host_version",
    "skill_digest"
  ],
  "additionalProperties": false
}
