{
  "schema_version": "pre-pin-freeze-manifest/1",
  "purpose": "Artefacts made by the product before the OpenTofu and Atmos pin migration, kept byte for byte so later steps can prove they did not silently migrate or invalidate them. Nothing here is regenerated by a test.",
  "frozen_at_commit": "5d709ba6daec7d3b6142caa85c48a9a4e0c8a33d",
  "frozen_at_commit_short": "5d709ba",
  "frozen_on": "2026-10-15",
  "data": "SYNTHETIC only; no network; no OpenTofu or Atmos binary fetched or run",
  "pins_in_the_frozen_artefacts": {
    "opentofu": "1.10.0",
    "atmos": "1.199.0",
    "synthetic_path_main_tf_required_version": ">= 1.10.0, < 1.11.0",
    "production_path_required_version": "= 1.10.0",
    "repository_context": "pins omitted, as wizard.py _repository_context creates it"
  },
  "path_bound": {
    "root": "/tmp/pre-pin-freeze",
    "kinds": [
      "session",
      "journey",
      "adoption"
    ],
    "reason": "The session, journey and adoption evidence record absolute paths and digests of files that contain them, so they only reconstruct at the path they were made at. Tests copy these kinds to this root (applying the modes and directories below) and remove it afterwards."
  },
  "interpreter_binding": {
    "executable_sha256": "e50d468e8b0adfb05733f5b87b3cff34829c4a8c1aea50c865aa8bdfe4bb150f",
    "executable_size": 8020928,
    "python_version": "3.12.3",
    "pyvenv_cfg": "home = /usr/bin\ninclude-system-site-packages = false\n",
    "reason": "protected.py SyntheticExecutor requires the journey executor tool to be byte-identical to the running interpreter (resolved) and pyvenv.cfg home to be its directory. The 8 MB copy of the interpreter is not frozen; tests copy the running interpreter in and compare its sha256 with the value here first."
  },
  "excluded_from_freeze": [
    {
      "path": "journey/session.json.journey/synthetic-executor/tool",
      "reason": "copy of the host interpreter, see interpreter_binding"
    },
    {
      "path": "session/attempts/",
      "reason": "wizard attempt receipts hold random operation ids and timestamps; a resume writes new ones"
    },
    {
      "path": "work/",
      "reason": "generate attempt receipts (random ids, timestamps); not an input to any test"
    },
    {
      "path": "logs/",
      "reason": "command output transcripts"
    },
    {
      "path": "journey/synthetic/ except capture.json and context.json",
      "reason": "other synthetic-generate outputs are not read by the journey"
    }
  ],
  "exit_codes": {
    "generate (production)": 2,
    "meaning": "cli.py:293 returns 2 when offline_mapping_complete is false (review only); the result status is succeeded_verified"
  },
  "kinds": {
    "inputs": {
      "files": [
        "inputs/synthetic-export.json",
        "inputs/production-export.json"
      ],
      "how_made": [
        "cp examples/supported/input/export.json inputs/synthetic-export.json (as it is)",
        "inputs/production-export.json: the same file with the edits plugin_tests/test_production.py inputs() makes (synthetic false, plugin exporter id, no references or ownership, portal creationSource, direct assignments); written by the python block in GENERATE.sh"
      ]
    },
    "contexts": {
      "files": [
        "contexts/synthetic-explicit-pins.context.json",
        "contexts/production-explicit-pins.context.json",
        "contexts/repository-omitted-pins.context.json"
      ],
      "how_made": [
        "cp examples/context.json contexts/synthetic-explicit-pins.context.json (as it is; explicit legacy pins; source_is_synthetic true so only the synthetic path takes it)",
        "contexts/production-explicit-pins.context.json: examples/context.json with source_is_synthetic false, component windows-privacy, stack workstation-pilot (the production path refuses source_is_synthetic true, production.py validate_context); explicit legacy pins kept",
        "contexts/repository-omitted-pins.context.json: copy of the context the repository wizard wrote (session/session.json.repository-context.*.json); no engine, atmos or provider pins"
      ]
    },
    "projects": {
      "files": [
        "projects/synthetic-explicit-pins/",
        "projects/production-explicit-pins/",
        "projects/production-omitted-pins/"
      ],
      "how_made": [
        "python scripts/intune-iac.py generate --input inputs/synthetic-export.json --context contexts/synthetic-explicit-pins.context.json --output projects/synthetic-explicit-pins --state-dir work/attempts-synthetic",
        "python scripts/intune-iac.py generate --input inputs/production-export.json --context contexts/production-explicit-pins.context.json --output projects/production-explicit-pins --state-dir work/attempts-production-explicit",
        "python scripts/intune-iac.py generate --input inputs/production-export.json --context contexts/repository-omitted-pins.context.json --output projects/production-omitted-pins --state-dir work/attempts-production-omitted"
      ],
      "differences_on_regeneration": "none expected; generated files carry no timestamps or random ids"
    },
    "session": {
      "files": [
        "session/"
      ],
      "how_made": [
        "printf deploy/dev, policy, 22222222-2222-4222-8222-222222222222, save | python scripts/intune-iac.py wizard --session session/session.json --repo session/repository --input session/export.json --output session/project"
      ],
      "state": "suspended at step preview, generated null, before generation"
    },
    "journey": {
      "files": [
        "journey/"
      ],
      "how_made": [
        "python scripts/intune-iac.py synthetic generate --output journey/synthetic --seed 721 --policies 1",
        "printf the 17 answers in GENERATE.sh | python scripts/intune-iac.py wizard --journey --session journey/session.json --input journey/synthetic/capture.json --context journey/synthetic/context.json --output journey/output"
      ],
      "state": "lifecycle complete_simulation"
    },
    "adoption": {
      "files": [
        "adoption/"
      ],
      "how_made": [
        "python scripts/intune-iac.py workbench init --root adoption/store --tenant <tenant_id of journey/synthetic/context.json>",
        "python scripts/intune-iac.py workbench adopt --root adoption/store --session journey/session.json --output adoption/handoff"
      ],
      "state": "handoff complete"
    }
  },
