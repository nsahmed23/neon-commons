{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/intune-iac/corrections/2.0.0/observed-policy.schema.json",
  "title": "observed-policy",
  "description": "Original proposed bounded correction contract; not an official Microsoft/provider schema and not live-qualified.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "minLength": 36,
      "maxLength": 36
    },
    "@odata.type": {
      "const": "#microsoft.graph.deviceManagementConfigurationPolicy"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 1500
    },
    "platforms": {
      "const": "windows10"
    },
    "technologies": {
      "const": "mdm"
    },
    "roleScopeTagIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "settingCount": {
      "type": "integer",
      "minimum": 1
    },
    "createdDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "lastModifiedDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "isAssigned": {
      "type": "boolean"
    },
    "templateReference": {
      "type": "object",
      "properties": {
        "templateId": {
          "const": ""
        },
        "templateFamily": {
          "const": "none"
        },
        "templateDisplayName": {
          "type": "null"
        },
        "templateDisplayVersion": {
          "type": "null"
        }
      },
      "required": [
        "templateId",
        "templateFamily",
        "templateDisplayName",
        "templateDisplayVersion"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "platforms",
    "technologies",
    "roleScopeTagIds",
    "settingCount",
    "templateReference"
  ],
  "additionalProperties": false
}
