efault value","description_kind":"plain","required":true}},"nesting_mode":"single"},"description":"Template reference at value level","description_kind":"plain","optional":true},"value":{"type":"string","description":"Setting value","description_kind":"plain","required":true}},"nesting_mode":"list"},"description":"Collection of simple settings","description_kind":"plain","optional":true},"simple_setting_value":{"nested_type":{"attributes":{"odata_type":{"type":"string","description":"OData type identifier","description_kind":"plain","required":true},"setting_value_template_reference":{"nested_type":{"attributes":{"setting_value_template_id":{"type":"string","description":"Setting value template identifier","description_kind":"plain","required":true},"use_template_default":{"type":"bool","description":"Whether to use template default value","description_kind":"plain","required":true}},"nesting_mode":"single"},"description":"Template reference at value level","description_kind":"plain","optional":true},"value":{"type":"string","description":"Setting value (can be string, integer, or secret - all represented as strings)","description_kind":"plain","required":true},"value_state":{"type":"string","description":"Value state. This is only used for secret settings and for a valid request, it must always be set to 'notEncrypted'","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description":"Simple setting value","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description":"singular settings catalog instance","description_kind":"plain","required":true}},"nesting_mode":"list"},"description":"Array-based settings collection","description_kind":"plain","required":true}},"nesting_mode":"single"},"description":"Settings Catalog (configuration policy) mobile app configuration settings","description_kind":"markdown","optional":true},"targeted_app_management_levels":{"type":"string","description":"Intended app management levels for this configuration. Valid values are: `unspecified`, `unmanaged`, `mdm`, `androidEnterprise`, `androidEnterpriseDedicatedDevicesWithAzureAdSharedMode`, `androidOpenSourceProjectUserAssociated`, `androidOpenSourceProjectUserless`","description_kind":"plain","optional":true,"computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true},"version":{"type":"string","description":"Version of the entity","description_kind":"plain","computed":true}},"description":"Manages targeted managed app configurations using the `/deviceAppManagement/targetedManagedAppConfigurations` endpoint. This resource is used to configuration used to deliver a set of custom settings as-is to all users in the targeted security group.","description_kind":"markdown"}},"microsoft365_graph_beta_device_and_app_management_win32_app":{"version":0,"block":{"attributes":{"allow_available_uninstall":{"type":"bool","description":"When TRUE, indicates that uninstall is supported from the company portal for the Windows app (Win32) with an Available assignment. When FALSE, indicates that uninstall is not supported for the Windows app (Win32) with an Available assignment. Default value is FALSE.","description_kind":"markdown","required":true},"allowed_architectures":{"type":["set","string"],"description":"The Windows architecture(s) for which this app can run on. Possible values are: none, x64, x86, arm64.","description_kind":"markdown","optional":true,"computed":true},"app_icon":{"nested_type":{"attributes":{"icon_file_path_source":{"type":"string","description":"The file path to the icon file to be uploaded. Supports various image formats which will be automatically converted to PNG.","description_kind":"markdown","optional":true},"icon_url_source":{"type":"string","description":"The web location of the icon file, can be a http(s) URL. Supports various image formats which will be automatically converted to PNG.","description_kind":"markdown","optional":true}},"nesting_mode":"single"},"description":"The source information for the app icon. Supports various image formats (JPEG, PNG, GIF, etc.) which will be automatically converted to PNG as required by Microsoft Intune.","description_kind":"markdown","optional":true},"app_installer":{"nested_type":{"attributes":{"installer_file_path_source":{"type":"string","description":"Local path to a prepackaged `.intunewin` file containing Detection.xml and its encrypted payload. Not returned by the API. Use a different path for each package version.","description_kind":"markdown","optional":true},"installer_url_source":{"type":"string","description":"HTTP(S) URL for a prepackaged `.intunewin` file containing Detection.xml and its encrypted payload. Not returned by the API. Use a different URL for each package version.","description_kind":"markdown","optional":true}},"nesting_mode":"single"},"description":"Source for a prepackaged `.intunewin` file containing Detection.xml and its encrypted payload. Mutually exclusive with `app_installer_zip`. Set exactly one local path or URL. Source changes publish a new content version without replacing the application. Omit both source blocks when managing an imported application's metadata only.","description_kind":"markdown","optional":true},"app_installer_zip":{"nested_type":{"attributes":{"installer_file_path_source":{"type":"string","description":"Local path to an unencrypted installer ZIP (a `.zip` file, or a legacy ZIP renamed `.intunewin`); the provider encrypts it before upload. Not returned by the API. Use a different path for each package version.","description_kind":"markdown","optional":true},"installer_url_source":{"type":"string","description":"HTTP(S) URL for an unencrypted installer ZIP (a `.zip` file, or a legacy ZIP renamed `.intunewin`); the provider encrypts it before upload. Not returned by the API. Use a different URL for each package version.","description_kind":"markdown","optional":true}},"nesting_mode":"single"},"description":"Source for an unencrypted installer ZIP (a `.zip` file, or a legacy ZIP renamed `.intunewin`); the provider encrypts it before upload. Mutually exclusive with `app_installer`. Set exactly one local path or URL. Source changes publish a new content version without replacing the application. Omit both source blocks when managing an imported application's metadata only.","description_kind":"markdown","optional":true},"categories":{"type":["set","string"],"description":"Set of category names to associate with this application. You can use either thebpredefined Intune category names like 'Business', 'Productivity', etc., or provide specific category UUIDs. Predefined values include: 'Other apps', 'Books \u0026 Reference', 'Data management', 'Productivity', 'Business', 'Development \u0026 Design', 'Photos \u0026 Media', 'Collaboration \u0026 Social', 'Computer management'.","description_kind":"markdown","optional":true},"committed_content_version":{"type":"string","description":"The internal committed content version.","description_kind":"markdown","computed":true},"content_version":{"nested_type":{"attributes":{"files":{"nested_type":{"attributes":{"azure_storage_uri":{"type":"string","description":"Indicates the Azure Storage URI that the file is uploaded to. Read-only.","description_kind":"markdown","computed":true},"azure_storage_uri_expiration":{"type":"string","description":"Indicates the date and time when the Azure storage URI expires, in ISO 8601 format. Read-only.","description_kind":"markdown","computed":true},"created_date_time":{"type":"string","description":"Indicates created date and time associated with app content file, in ISO 8601 format. Read-only.","description_kind":"markdown","computed":true},"is_committed":{"type":"bool","description":"A value indicating whether the file is committed. A committed app content file has been fully uploaded and validated by the Intune service. Read-only.","description_kind":"markdown","computed":true},"is_dependency":{"type":"bool","description":"Indicates whether this content file is a dependency for the main content file.","description_kind":"markdown","computed":true},"is_framework_file":{"type":"bool","description":"Indicates whether this content file is a framework file.","description_kind":"markdown","computed":true},"name":{"type":"string","description":"Indicates the name of the file.","description_kind":"markdown","computed":true},"size":{"type":"number","description":"Indicates the original size of the file, in bytes.","description_kind":"markdown","computed":true},"size_encrypted":{"type":"number","description":"Indicates the size of the file after encryption, in bytes.","description_kind":"markdown","computed":true},"upload_state":{"type":"string","description":"Indicates the state of the current upload request. This property is read-only.","description_kind":"markdown","computed":true}},"nesting_mode":"set"},"description":"The files associated with this content version.","description_kind":"markdown","computed":true},"id":{"type":"string","description":"The unique identifier for this content version. This ID is assigned during creation of the content version. Read-only.","description_kind":"markdown","computed":true}},"nesting_mode":"list"},"description":"The committed content version of the app, including its files. Only the currently committed version is shown.","description_kind":"markdown","optional":true,"computed":true},"created_date_time":{"type":"string","description":"The date and time the app was created. This property is read-only.","description_kind":"markdown","computed":true},"dependent_app_count":{"type":"number","description":"The total number of dependencies the child app has. This property is read-only.","description_kind":"markdown","computed":true},"description":{"type":"string","description":"Required. The description of the resource. Maximum length is 10000 characters.","description_kind":"markdown","required":true},"detection_rules":{"nested_type":{"attributes":{"check_32_bit_on_64_system":{"type":"bool","description":"Whether to check 32-bit registry or file system on 64-bit system. Applicable for registry, file_system, and PowerShell script detection.","description_kind":"markdown","optional":true},"detection_type":{"type":"string","description":"The detection rule type. Possible values are: registry, msi_information, file_system, powershell_script.","description_kind":"markdown","required":true},"detection_value":{"type":"string","description":"The registry detection value for registry detection.","description_kind":"markdown","optional":true},"enforce_signature_check":{"type":"bool","description":"Whether to enforce signature checking for the PowerShell script.","description_kind":"markdown","optional":true},"file_or_folder_name":{"type":"string","description":"The file name for file system detection.","description_kind":"markdown","optional":true},"file_path":{"type":"string","description":"The file path for file system detection.","description_kind":"markdown","optional":true},"file_system_detection_operator":{"type":"string","description":"The filesystem detection operator for filesystem detection. Possible values are: notConfigured, equal, notEqual, greaterThan, greaterThanOrEqual, lessThan, lessThanOrEqual. Used for registry and file_system detection types.","description_kind":"markdown","optional":true},"file_system_detection_type":{"type":"string","description":"The comparison operator for detection. Possible values are: notConfigured, exists,modifiedDate, createdDate, version, sizeInMB, doesNotExist.","description_kind":"markdown","optional":true},"key_path":{"type":"string","description":"The registry key path for registry detection.","description_kind":"markdown","optional":true},"product_code":{"type":"string","description":"The MSI product code for MSI detection.","description_kind":"markdown","optional":true},"product_version":{"type":"string","description":"The MSI product version for MSI detection.","description_kind":"markdown","optional":true},"product_version_operator":{"type":"string","description":"The MSI product version operator for MSI detection.Possible values are: notConfigured, equal, notEqual, greaterThan, greaterThanOrEqual, lessThan, lessThanOrEqual. Used for registry and file_system detection types.","description_kind":"markdown","optional":true},"registry_detection_operator":{"type":"string","description":"The registry detection operator for registry detection. Possible values are: notConfigured, equal, notEqual, greaterThan, greaterThanOrEqual, lessThan, lessThanOrEqual. Used for registry and file_system detection types.","description_kind":"markdown","optional":true},"registry_detection_type":{"type":"string","description":"The registry detection type for registry detection. Possible values are: notConfigured, exists, doesNotExist, string, integer, version.","description_kind":"markdown","optional":true},"run_as_32_bit":{"type":"bool","description":"Whether to run the PowerShell script in 32-bit mode on 64-bit systems.","description_kind":"markdown","optional":true},"script_content":{"type":"string","description":"The PowerShell script content to run for script detection.This will be base64-encoded before being sent to the API. Supports PowerShell 5.1 and PowerShell 7.0.","description_kind":"markdown","optional":true},"value_name":{"type":"string","description":"The registry value name for registry detection.","description_kind":"markdown","optional":true}},"nesting_mode":"list"},"description":"**DEPRECATED**: Use the `rules` block instead with key rule_type set to `detection`, to configure the detection rules to detect Win32 Line of Business (LoB) app.","description_kind":"markdown","deprecated":true,"deprecation_message":"Use the `rules` attribute instead. The `detection_rules` attribute is deprecated and will be removed in a future release. Configuring both `detection_rules` and `rules` is not supported.","optional":true},"developer":{"type":"string","description":"The developer of the app.","description_kind":"markdown","optional":true,"computed":true},"display_name":{"type":"string","description":"The admin provided or imported title of the app.","description_kind":"markdown","required":true},"display_version":{"type":"string","description":"The version displayed in the UX for this app.","description_kind":"markdown","optional":true,"computed":true},"file_name":{"type":"string","description":"The configured name of the main LOB application file. For prepackaged content, Microsoft Graph receives the inner filename from `Detection.xml`; for ZIP sources it receives the ZIP filename with an `.intunewin` extension.","description_kind":"markdown","required":true},"id":{"type":"string","description":"The unique identifier for this Intune win32 lob application","description_kind":"markdown","computed":true},"information_url":{"type":"string","description":"The more information Url.","description_kind":"markdown","optional":true,"computed":true},"install_command_line":{"type":"string","description":"The command line to install this app. Typically formatted as 'msiexec /i \"application_name.msi\" /qn'","description_kind":"markdown","required":true},"install_experience":{"nested_type":{"attributes":{"device_restart_behavior":{"type":"string","description":"The device restart behavior. Possible values are: basedOnReturnCode, allow, suppress, force.","description_kind":"markdown","optional":true},"max_run_time_in_minutes":{"type":"number","description":"The maximum run time in minutes for the installation.","description_kind":"markdown","optional":true},"run_as_account":{"type":"string","description":"The execution context. Possible values are: system, user.","description_kind":"markdown","optional":true}},"nesting_mode":"single"},"description":"The install experience for this app.","description_kind":"markdown","optional":true},"is_assigned":{"type":"bool","description":"The value indicating whether the app is assigned to at least one group. This property is read-only.","description_kind":"markdown","computed":true},"is_featured":{"type":"bool","description":"The value indicating whether the app is marked as featured by the admin.","description_kind":"markdown","optional":true,"computed":true},"last_modified_date_time":{"type":"string","description":"The date and time the app was last modified. This property is read-only.","description_kind":"markdown","computed":true},"minimum_cpu_speed_in_mhz":{"type":"number","description":"The value for the minimum CPU speed which is required to install this app.","description_kind":"markdown","optional":true},"minimum_free_disk_space_in_mb":{"type":"number","description":"The value for the minimum free disk space which is required to install this app.","description_kind":"markdown","optional":true},"minimum_memory_in_mb":{"type":"number","description":"The value for the minimum physical memory which is required to install this app.","description_kind":"markdown","optional":true},"minimum_number_of_processors":{"type":"number","description":"The value for the minimum number of processors which is required to install this app.","description_kind":"markdown","optional":true},"minimum_supported_windows_release":{"type":"string","description":"The value for the minimum supported windows release.","description_kind":"markdown","required":true},"msi_information":{"nested_type":{"attributes":{"package_type":{"type":"string","description":"The MSI package type. Possible values are: perMachine, perUser.","description_kind":"markdown","required":true},"product_code":{"type":"string","description":"The MSI product code.","description_kind":"markdown","optional":true},"product_name":{"type":"string","description":"The MSI product name.","description_kind":"markdown","optional":true},"product_version":{"type":"string","description":"The MSI product version.","description_kind":"markdown","required":true},"publisher":{"type":"string","description":"The MSI publisher.","description_kind":"markdown","optional":true},"requires_reboot":{"type":"bool","description":"A value indicating whether the MSI app requires a reboot.","description_kind":"markdown","required":true},"upgrade_code":{"type":"string","description":"The MSI upgrade code.","description_kind":"markdown","required":true}},"nesting_mode":"single"},"description":"The MSI details if this Win32 app is an MSI app. Only required for MSI-based installers.","description_kind":"markdown","optional":true},"notes":{"type":"string","description":"Notes for the app.","description_kind":"markdown","optional":true},"owner":{"type":"string","description":"The owner of the app.","description_kind":"markdown","optional":true},"privacy_information_url":{"type":"string","description":"The privacy statement Url.","description_kind":"markdown","optional":true},"publisher":{"type":"string","description":"The publisher of the Intune macOS pkg application.","description_kind":"markdown","required":true},"publishing_state":{"type":"string","description":"The publishing state for the app. The app cannot be assigned unless the app is published. This property is read-only. Possible values are: notPublished, processing, published.","description_kind":"markdown","computed":true},"requirement_rules":{"nested_type":{"attributes":{"check_32_bit_on_64_system":{"type":"bool","description":"A value indicating whether to check 32-bit on 64-bit system.","description_kind":"markdown","optional":true},"detection_type":{"type":"string","description":"The detection type for registry requirement.","description_kind":"markdown","optional":true},"detection_value":{"type":"string","description":"The value to check for.","description_kind":"markdown","optional":true},"file_or_folder_name":{"type":"string","description":"The file or folder name to check for file requirement.","description_kind":"markdown","optional":true},"key_path":{"type":"string","description":"The registry key path for registry requirement.","description_kind":"markdown","optional":true},"operator":{"type":"string","description":"The operator for the requirement. Possible values are: notConfigured, equal, notEqual, greaterThan, greaterThanOrEqual, lessThan, lessThanOrEqual.","description_kind":"markdown","optional":true},"requirement_type":{"type":"string","description":"The requirement rule type. Possible values are: registry, file, script.","description_kind":"markdown","required":true},"value_name":{"type":"string","description":"The registry value name for registry requirement.","description_kind":"markdown","optional":true}},"nesting_mode":"list"},"description":"**DEPRECATED**: Use the `rules` block instead with key rule_type set to `requirement`, to configure the requirement rules to detect Win32 Line of Business (LoB) app.","description_kind":"markdown","deprecated":true,"deprecation_message":"Use the `rules` attribute instead. The `requirement_rules` attribute is deprecated and will be removed in a future release. Configuring both `requirement_rules` and `rules` is not supported.","optional":true},"return_codes":{"nested_type":{"attributes":{"return_code":{"type":"number","description":"The return code.","description_kind":"markdown","required":true},"type":{"type":"string","description":"The return code type. Possible values are: failed, success, softReboot, hardReboot, retry.","description_kind":"markdown","required":true}},"nesting_mode":"list"},"description":"The return codes for post installation behavior.","description_kind":"markdown","optional":true},"role_scope_tag_ids":{"type":["set","string"],"description":"Set of scope tag IDs for this Settings Catalog template profile.","description_kind":"markdown","optional":true,"computed":true},"rules":{"nested_type":{"attributes":{"check_32_bit_on_64_system":{"type":"bool","description":"A value indicating whether to check 32-bit on 64-bit system.","description_kind":"markdown","optional":true},"comparison_value":{"type":"string","description":"The value to compare against.","description_kind":"markdown","optional":true},"display_name":{"type":"string","description":"The display name for PowerShell script rules.","description_kind":"markdown","optional":true},"enforce_signature_check":{"type":"bool","description":"Whether to enforce signature checking for PowerShell script rules.","description_kind":"markdown","optional":true},"file_or_folder_name":{"type":"string","description":"The file or folder name to check. Required for file_system rules.","description_kind":"markdown","optional":true},"file_system_operation_type":{"type":"string","description":"The operation type for file system rules. Possible values are: notConfigured, exists, modifiedDate, createdDate, version, sizeInMB, doesNotExist.","description_kind":"markdown","optional":true},"key_path":{"type":"string","description":"The registry key path to detect or check. Required for registry rules.","description_kind":"markdown","optional":true},"lob_app_rule_operator":{"type":"string","description":"The operator for the rule. Possible values are: notConfigured, equal, notEqual, greaterThan, greaterThanOrEqual, lessThan, lessThanOrEqual.","description_kind":"markdown","optional":true},"operation_type":{"type":"string","description":"The operation type for registry rules. Possible values are: notConfigured, exists, doesNotExist, string, integer, version.","description_kind":"markdown","optional":true},"path":{"type":"string","description":"The path to the file or folder. Required for file_system rules.","description_kind":"markdown","optional":true},"powershell_script_rule_operation_type":{"type":"string","description":"The operation type for PowerShell script rules. Possible values are: notConfigured, string, dateTime, integer, float, version, boolean.","description_kind":"markdown","optional":true},"rule_sub_type":{"type":"string","description":"The rule sub-type. Possible values are: registry, file_system, powershell_script.","description_kind":"markdown","required":true},"rule_type":{"type":"string","description":"The rule type. Possible values are: detection, requirement.","description_kind":"markdown","required":true},"run_as_32_bit":{"type":"bool","description":"Whether to run PowerShell scripts in 32-bit mode on 64-bit systems.","description_kind":"markdown","optional":true},"run_as_account":{"type":"string","description":"The execution context for PowerShell scripts. Possible values are: system, user.","description_kind":"markdown","optional":true},"script_content":{"type":"string","description":"The PowerShell script content to run for script detection.This will be base64-encoded before being sent to the API. Supports PowerShell 5.1 and PowerShell 7.0.","description_kind":"markdown","optional":true},"value_name":{"type":"string","description":"The registry value name to detect or check. Required for registry rules.","description_kind":"markdown","optional":true}},"nesting_mode":"list"},"description":"The detection and requirement rules for this app.","description_kind":"markdown","optional":true},"setup_file_path":{"type":"string","description":"The relative path of the setup file in the encrypted Win32LobApp package.","description_kind":"markdown","optional":true},"size":{"type":"number","description":"The total size, including all uploaded files. This property is read-only.","description_kind":"markdown","computed":true},"superseded_app_count":{"type":"number","description":"The total number of apps this app is directly or indirectly superseded by. This property is read-only.","description_kind":"markdown","computed":true},"superseding_app_count":{"type":"number","description":"The total number of apps this app directly or indirectly supersedes. This property is read-only.","description_kind":"markdown","computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true},"uninstall_command_line":{"type":"string","description":"The command line to uninstall this app. Typically formatted as 'msiexec /x {00000000-0000-0000-0000-000000000000} /qn'","description_kind":"markdown","required":true},"upload_state":{"type":"number","description":"The upload state. Possible values are: 0 - Not Ready, 1 - Ready, 2 - Processing. This property is read-only.","description_kind":"markdown","computed":true}},"description":"Manages Win32 applications in Microsoft Intune using the `/deviceAppManagement/mobileApps` endpoint. This resource is used to deploy custom Windows applications (.exe, .msi) with advanced installation logic, detection rules, and dependency management. Supply either a prepackaged .intunewin file or an unencrypted installer ZIP.","description_kind":"markdown"}},"microsoft365_graph_beta_device_and_app_management_win_get_app":{"version":0,"block":{"attributes":{"automatically_generate_metadata":{"type":"bool","description":"When set to `true`, the provider will automatically fetch metadata from the Microsoft Store for Business using the package identifier. This will populate the `display_name`, `description`, `publisher`, and 'icon' fields.","description_kind":"markdown","required":true},"categories":{"type":["set","string"],"description":"Set of category names to associate with this application. You can use either thebpredefined Intune category names like 'Business', 'Productivity', etc., or provide specific category UUIDs. Predefined values include: 'Other apps', 'Books \u0026 Reference', 'Data management', 'Productivity', 'Business', 'Development \u0026 Design', 'Photos \u0026 Media', 'Collaboration \u0026 Social', 'Computer management'.","description_kind":"markdown","optional":true},"created_date_time":{"type":"string","description":"The date and time the app was created. This property is read-only.","description_kind":"markdown","computed":true},"dependent_app_count":{"type":"number","description":"The total number of dependencies the child app has. This property is read-only.","description_kind":"markdown","computed":true},"description":{"type":"string","description":"The description of the resource. Maximum length is 1500 characters. This field is automatically populated based on the package identifier when `automatically_generate_metadata` is set to true.","description_kind":"markdown","optional":true,"computed":true},"developer":{"type":"string","description":"The developer of the app.","description_kind":"markdown","optional":true},"display_name":{"type":"string","description":"The title of the WinGet app imported from the Microsoft Store for Business.This field value must match the expected title of the app in the Microsoft Store for Business associated with the `package_identifier`.This field is automatically populated based on the package identifier when `automatically_generate_metadata` is set to true.","description_kind":"markdown","optional":true,"computed":true},"id":{"type":"string","description":"The unique identifier for this Intune Microsoft Store app","description_kind":"markdown","computed":true},"information_url":{"type":"string","description":"The more information Url.","description_kind":"markdown","optional":true},"install_experience":{"nested_type":{"attributes":{"run_as_account":{"type":"string","description":"The account type (System or User) that actions should be run as on target devices.  Required at creation time.","description_kind":"markdown","required":true}},"nesting_mode":"single"},"description":"The install experience settings associated with this application.the value is idempotent and any changes to this field will trigger a recreation of the application.","description_kind":"markdown","required":true},"is_assigned":{"type":"bool","description":"The value indicating whether the app is assigned to at least one group. This property is read-only.","description_kind":"markdown","computed":true},"is_featured":{"type":"bool","description":"The value indicating whether the app is marked as featured by the admin. Default is false.","description_kind":"markdown","optional":true,"computed":true},"large_icon":{"nested_type":{"attributes":{"type":{"type":"string","description":"The MIME type of the app's large icon, automatically populated based on the `package_identifier` when `automatically_generate_metadata` is true. Example: `image/png`","description_kind":"markdown","optional":true,"computed":true},"value":{"type":"string","description":"The icon image to use for the winget app. This field is automatically populated based on the `package_identifier` when `automatically_generate_metadata` is set to true.","description_kind":"markdown","optional":true,"computed":true,"sensitive":true}},"nesting_mode":"single"},"description":"The large icon for the WinGet app, automatically downloaded and set from the Microsoft Store for Business.","description_kind":"markdown","optional":true,"computed":true},"last_modified_date_time":{"type":"string","description":"The date and time the app was last modified. This property is read-only.","description_kind":"markdown","computed":true},"manifest_hash":{"type":"string","description":"Hash of package metadata properties used to validate that the application matches the metadata in the source repository.","description_kind":"markdown","computed":true},"notes":{"type":"string","description":"Notes for the app.","description_kind":"markdown","optional":true},"owner":{"type":"string","description":"The owner of the app.","description_kind":"markdown","optional":true},"package_identifier":{"type":"string","description":"The **unique package identifier** for the WinGet/Microsoft Store app from the storefront.\n\nFor example, for the app Microsoft Edge Browser URL [https://apps.microsoft.com/detail/xpfftq037jwmhs?hl=en-us\u0026gl=US](https://apps.microsoft.com/detail/xpfftq037jwmhs?hl=en-us\u0026gl=US), the package identifier is `xpfftq037jwmhs`.\n\n**Important notes:**\n- This identifier is **required** at creation time.\n- It **cannot be modified** for existing Terraform-deployed WinGet/Microsoft Store apps.\n\nattempting to modify this value will result in a failed request.","description_kind":"markdown","required":true},"privacy_information_url":{"type":"string","description":"The privacy statement Url.","description_kind":"markdown","optional":true},"publisher":{"type":"string","description":"The publisher of the WinGet/ Microsoft Store for Business app.This field is automatically populated based on the package identifier when `automatically_generate_metadata` is set to true.","description_kind":"markdown","optional":true,"computed":true},"publishing_state":{"type":"string","description":"The publishing state for the app. The app cannot be assigned unless the app is published. Possible values are: notPublished, processing, published.","description_kind":"markdown","computed":true},"role_scope_tag_ids":{"type":["set","string"],"description":"Set of scope tag IDs for this Settings Catalog template profile.","description_kind":"markdown","optional":true,"computed":true},"superseded_app_count":{"type":"number","description":"The total number of apps this app is directly or indirectly superseded by. This property is read-only.","description_kind":"markdown","computed":true},"superseding_app_count":{"type":"number","description":"The total number of apps this app directly or indirectly supersedes. This property is read-only.","description_kind":"markdown","computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true},"upload_state":{"type":"number","description":"The upload state. Possible values are: 0 - Not Ready, 1 - Ready, 2 - Processing. This property is read-only.","description_kind":"markdown","computed":true}},"description":"Manages WinGet applications from the Microsoft Store using the `/deviceAppManagement/mobileApps` endpoint. This resource is used to winGet apps enable deployment of Microsoft Store applications with automatic metadata population, streamlined package management, and integration with the Windows Package Manager for efficient app distribution to managed devices.","description_kind":"markdown"}},"microsoft365_graph_beta_device_and_app_management_windows_managed_app_protection":{"version":0,"block":{"attributes":{"allowed_inbound_data_transfer_sources":{"type":"string","description":"Indicates the sources from which data is allowed to be transferred into managed apps. Possible values: `allApps`, `none`.","description_kind":"markdown","optional":true,"computed":true},"allowed_outbound_clipboard_sharing_level":{"type":"string","description":"Indicates the level to which the clipboard may be shared across org and non-org resources. Possible values: `anyDestinationAnySource`, `none`, `orgDestinationAnySource`, `orgDestinationOrgSource`.","description_kind":"markdown","optional":true,"computed":true},"allowed_outbound_data_transfer_destinations":{"type":"string","description":"Indicates the destinations to which data is allowed to be transferred from managed apps. Possible values: `allApps`, `none`.","description_kind":"markdown","optional":true,"computed":true},"app_action_if_unable_to_authenticate_user":{"type":"string","description":"Action to take when the user is unable to check in because their authentication token is invalid. Possible values: `block`, `wipe`, `warn`, `blockWhenSettingIsSupported`. If not set, no action is taken.","description_kind":"markdown","optional":true,"computed":true},"created_date_time":{"type":"string","description":"The date and time the policy was created. Set by the API, read-only.","description_kind":"markdown","computed":true},"deployed_app_count":{"type":"number","description":"Indicates the total number of applications for which the current policy is deployed. Set by the API, read-only.","description_kind":"markdown","computed":true},"description":{"type":"string","description":"The policy's description.","description_kind":"markdown","optional":true,"computed":true},"display_name":{"type":"string","description":"Policy display name. Must be unique within your tenant.","description_kind":"markdown","required":true},"id":{"type":"string","description":"The unique identifier for this Windows managed app protection policy. Set by the API on creation.","description_kind":"markdown","computed":true},"is_assigned":{"type":"bool","description":"When TRUE, indicates that the policy is deployed to some inclusion groups. Set by the API, read-only.","description_kind":"markdown","computed":true},"last_modified_date_time":{"type":"string","description":"The date and time the policy was last modified. Set by the API, read-only.","description_kind":"markdown","computed":true},"maximum_allowed_device_threat_level":{"type":"string","description":"Maximum allowed device threat level as reported by the Mobile Threat Defense app. Possible values: `notConfigured`, `secured`, `low`, `medium`, `high`.","description_kind":"markdown","optional":true,"computed":true},"maximum_required_os_version":{"type":"string","description":"Versions greater than the specified version will block the managed app from accessing company data.","description_kind":"markdown","optional":true,"computed":true},"maximum_warning_os_version":{"type":"string","description":"Versions greater than the specified version will result in a warning message on the managed app.","description_kind":"markdown","optional":true,"computed":true},"maximum_wipe_os_version":{"type":"string","description":"Versions greater than the specified version will wipe the managed app and associated company data.","description_kind":"markdown","optional":true,"computed":true},"minimum_required_app_version":{"type":"string","description":"Versions less than the specified version will block the managed app from accessing company data.","description_kind":"markdown","optional":true,"computed":true},"minimum_required_os_version":{"type":"string","description":"Versions less than the specified version will block the managed app from accessing company data. e.g. `10.0.19041`.","description_kind":"markdown","optional":true,"computed":true},"minimum_required_sdk_version":{"type":"string","description":"Versions less than the specified version will block the managed app from accessing company data. e.g. `8.1.0`.","description_kind":"markdown","optional":true,"computed":true},"minimum_warning_app_version":{"type":"string","description":"Versions less than the specified version will result in a warning message on the managed app.","description_kind":"markdown","optional":true,"computed":true},"minimum_warning_os_version":{"type":"string","description":"Versions less than the specified version will result in a warning message on the managed app. e.g. `10.0.19041`.","description_kind":"markdown","optional":true,"computed":true},"minimum_wipe_app_version":{"type":"string","description":"Versions less than the specified version will wipe the managed app and associated company data.","description_kind":"markdown","optional":true,"computed":true},"minimum_wipe_os_version":{"type":"string","description":"Versions less than the specified version will wipe the managed app and associated company data. e.g. `10.0.19041`.","description_kind":"markdown","optional":true,"computed":true},"minimum_wipe_sdk_version":{"type":"string","description":"Versions less than the specified version will wipe the managed app and associated company data. e.g. `8.1.0`.","description_kind":"markdown","optional":true,"computed":true},"mobile_threat_defense_remediation_action":{"type":"string","description":"Action to take if the mobile threat defense threat threshold is not met. Possible values: `block`, `wipe`. Note: `warn` is not supported for this property.","description_kind":"markdown","optional":true,"computed":true},"period_offline_before_access_check":{"type":"string","description":"The period after which access is checked when the device is not connected to the internet. ISO 8601 duration format. e.g. `PT5M` for 5 minutes, `PT0S` to block immediately.","description_kind":"markdown","optional":true,"computed":true},"period_offline_before_wipe_is_enforced":{"type":"string","description":"The amount of time an app is allowed to remain disconnected from the internet before all managed data is wiped. ISO 8601 duration format. e.g. `P5D` for 5 days, `PT0S` to never wipe.","description_kind":"markdown","optional":true,"computed":true},"print_blocked":{"type":"bool","description":"When TRUE, printing is blocked from managed apps. When FALSE, printing is allowed. Default value is FALSE.","description_kind":"markdown","optional":true,"computed":true},"role_scope_tag_ids":{"type":["list","string"],"description":"List of scope tag IDs for this entity instance.","description_kind":"markdown","optional":true,"computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true},"version":{"type":"string","description":"Version of the entity. Set by the API, read-only.","description_kind":"markdown","computed":true}},"description":"Manages Windows Mobile Application Management (MAM) app protection policies in Microsoft Intune. These policies control how managed apps handle corporate data on Windows devices, including data transfer restrictions, clipboard behaviour, and threat response actions. Uses the `/beta/deviceAppManagement/windowsManagedAppProtections` endpoint.","description_kind":"markdown"}},"microsoft365_graph_beta_device_and_app_management_windows_managed_mobile_app":{"version":0,"block":{"attributes":{"id":{"type":"string","description":"The unique identifier for this Windows managed mobile app","description_kind":"markdown","computed":true},"managed_app_protection_id":{"type":"string","description":"The ID of the Windows managed app protection policy to associate this app with","description_kind":"markdown","required":true},"mobile_app_identifier":{"nested_type":{"attributes":{"windows_app_id":{"type":"string","description":"The Windows app identifier (e.g., Microsoft.WindowsApp_8wekyb3d8bbwe)","description_kind":"markdown","required":true}},"nesting_mode":"single"},"description":"The Windows app identifier information","description_kind":"markdown","required":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true},"version":{"type":"string","description":"The version of the managed mobile app","description_kind":"markdown","optional":true,"computed":true}},"description":"Manages Windows managed mobile apps in Microsoft Intune Windows managed app protection policies. This resource associates Windows apps with Windows managed app protection policies for Mobile Application Management (MAM).","description_kind":"markdown"}},"microsoft365_graph_beta_device_and_app_management_windows_web_app":{"version":0,"block":{"attributes":{"app_icon":{"nested_type":{"attributes":{"icon_file_path_source":{"type":"string","description":"The file path to the icon file to be uploaded. Supports various image formats which will be automatically converted to PNG.","description_kind":"markdown","optional":true},"icon_url_source":{"type":"string","description":"The web location of the icon file, can be a http(s) URL. Supports various image formats which will be automatically converted to PNG.","description_kind":"markdown","optional":true}},"nesting_mode":"single"},"description":"The source information for the app icon. Supports various image formats (JPEG, PNG, GIF, etc.) which will be automatically converted to PNG as required by Microsoft Intune.","description_kind":"markdown","optional":true},"app_url":{"type":"string","description":"Indicates Windows web clip app URL. Example: 'https://www.contoso.com'","description_kind":"markdown","required":true},"categories":{"type":["set","string"],"description":"The list of categories for this app. You can use either the predefined Intune category names like 'Business', 'Productivity', etc., or provide specific category UUIDs.","description_kind":"markdown","optional":true},"created_date_time":{"type":"string","description":"The date and time the app was created. This property is read-only.","description_kind":"markdown","computed":true},"dependent_app_count":{"type":"number","description":"The total number of dependencies the child app has. This property is read-only.","description_kind":"markdown","computed":true},"description":{"type":"string","description":"Required. The description of the resource. Maximum length is 10000 characters.","description_kind":"markdown","required":true},"developer":{"type":"string","description":"The developer of the app.","description_kind":"markdown","optional":true},"display_name":{"type":"string","description":"The admin provided or imported title of the app.","description_kind":"markdown","required":true},"id":{"type":"string","description":"Key of the entity. This property is read-only.","description_kind":"markdown","computed":true},"information_url":{"type":"string","description":"The more information Url.","description_kind":"markdown","optional":true},"is_assigned":{"type":"bool","description":"The value indicating whether the app is assigned to at least one group. This property is read-only.","description_kind":"markdown","computed":true},"is_featured":{"type":"bool","description":"The value indicating whether the app is marked as featured by the admin.","description_kind":"markdown","optional":true},"last_modified_date_time":{"type":"string","description":"The date and time the app was last modified. This property is read-only.","description_kind":"markdown","computed":true},"notes":{"type":"string","description":"Notes for the app.","description_kind":"markdown","optional":true},"owner":{"type":"string","description":"The owner of the app.","description_kind":"markdown","optional":true},"privacy_information_url":{"type":"string","description":"The privacy statement Url.","description_kind":"markdown","optional":true},"publisher":{"type":"string","description":"The publisher of the app.","description_kind":"markdown","required":true},"publishing_state":{"type":"string","description":"The publishing state for the app. The app cannot be assigned unless the app is published. This property is read-only. Possible values are: notPublished, processing, published.","description_kind":"markdown","computed":true},"role_scope_tag_ids":{"type":["set","string"],"description":"List of scope tag ids for this mobile app.","description_kind":"markdown","optional":true,"computed":true},"superseded_app_count":{"type":"number","description":"The total number of apps this app is directly or indirectly superseded by. This property is read-only.","description_kind":"markdown","computed":true},"superseding_app_count":{"type":"number","description":"The total number of apps this app directly or indirectly supersedes. This property is read-only.","description_kind":"markdown","computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true},"upload_state":{"type":"number","description":"The upload state. Possible values are: 0 - Not Ready, 1 - Ready, 2 - Processing. This property is read-only.","description_kind":"markdown","computed":true}},"description":"Manages Windows Web Clip apps using the `/deviceAppManagement/mobileApps` endpoint. This resource is used to windows Web Clips are shortcuts to web pages that appear as apps on Windows devices.","description_kind":"markdown"}},"microsoft365_graph_beta_device_management_android_device_owner_compliance_policy":{"version":0,"block":{"attributes":{"advanced_threat_protection_required_security_level":{"type":"string","description":"Indicates the Microsoft Defender for Endpoint (also referred to Microsoft Defender Advanced Threat Protection (MDATP)) minimum risk level to report noncompliance. Possible values are: unavailable, secured, low, medium, high, notSet.","description_kind":"markdown","optional":true,"computed":true},"assignments":{"nested_type":{"attributes":{"filter_id":{"type":"string","description":"ID of the filter to apply to the assignment.","description_kind":"markdown","optional":true,"computed":true},"filter_type":{"type":"string","description":"Type of filter to apply. Must be one of: 'include', 'exclude', or 'none'.","description_kind":"markdown","optional":true,"computed":true},"group_id":{"type":"string","description":"The Entra ID group ID to include or exclude in the assignment. Required when type is 'groupAssignmentTarget' or 'exclusionGroupAssignmentTarget'.","description_kind":"markdown","optional":true},"type":{"type":"string","description":"Type of assignment target. Must be one of: 'allDevicesAssignmentTarget', 'allLicensedUsersAssignmentTarget', 'groupAssignmentTarget', 'exclusionGroupAssignmentTarget'.","description_kind":"markdown","required":true}},"nesting_mode":"set"},"description":"Assignments for the compliance policy. Each assignment specifies the target group and schedule for script execution.","description_kind":"markdown","optional":true},"description":{"type":"string","description":"Optional description of the resource. Maximum length is 1500 characters.","description_kind":"markdown","optional":true,"computed":true},"device_threat_protection_enabled":{"type":"bool","description":"Indicates whether the policy requires devices have device threat protection enabled. When TRUE, threat protection is enabled. When FALSE, threat protection is not enabled. Default is FALSE.","description_kind":"markdown","optional":true,"computed":true},"device_threat_protection_required_security_level":{"type":"string","description":"Indicates the minimum mobile threat protection risk level to that results in Intune reporting device noncompliance. Possible values are: unavailable, secured, low, medium, high, notSet.","description_kind":"markdown","optional":true,"computed":true},"display_name":{"type":"string","description":"Admin provided name of the device configuration. Inherited from deviceCompliancePolicy","description_kind":"markdown","required":true},"id":{"type":"string","description":"Key of the entity. Inherited from deviceCompliancePolicy","description_kind":"markdown","computed":true},"min_android_security_patch_level":{"type":"string","description":"Indicates the minimum Android security patch level required to mark the device as compliant. Must be a valid date format (YYYY-MM-DD). Example: 2026-10-01, 2026-10-31 etc.","description_kind":"markdown","optional":true},"os_maximum_version":{"type":"string","description":"Indicates the maximum Android version required to mark the device as compliant. For example: '15'","description_kind":"markdown","optional":true},"os_minimum_version":{"type":"string","description":"Indicates the minimum Android version required to mark the device as compliant. For example: '14'","description_kind":"markdown","optional":true},"password_expiration_days":{"type":"number","description":"Indicates the number of days before the password expires. Valid values 1 to 365.","description_kind":"markdown","optional":true},"password_minimum_length":{"type":"number","description":"Indicates the minimum password length required to mark the device as compliant. Valid values are 4 to 16, inclusive. Valid values 4 to 16","description_kind":"markdown","optional":true},"password_minimum_letter_characters":{"type":"number","description":"Indicates the minimum number of letter characters required for device password for the device to be marked compliant. Valid values 1 to 16.","description_kind":"markdown","optional":true},"password_minimum_lower_case_characters":{"type":"number","description":"Indicates the minimum number of lower case characters required for device password for the device to be marked compliant. Valid values 1 to 16.","description_kind":"markdown","optional":true},"password_minimum_non_letter_characters":{"type":"number","description":"Indicates the minimum number of non-letter characters required for device password for the device to be marked compliant. Valid values 1 to 16.","description_kind":"markdown","optional":true},"password_minimum_numeric_characters":{"type":"number","description":"Indicates the minimum number of numeric characters required for device password for the device to be marked compliant. Valid values 1 to 16.","description_kind":"markdown","optional":true},"password_minimum_symbol_characters":{"type":"number","description":"Indicates the minimum number of symbol characters required for device password for the device to be marked compliant. Valid values 1 to 16.","description_kind":"markdown","optional":true},"password_minimum_upper_case_characters":{"type":"number","description":"Indicates the minimum number of upper case letter characters required for device password for the device to be marked compliant. Valid values 1 to 16.","description_kind":"markdown","optional":true},"password_minutes_of_inactivity_before_lock":{"type":"number","description":"Indicates the number of minutes of inactivity before a password is required.","description_kind":"markdown","optional":true},"password_previous_password_count_to_block":{"type":"number","description":"Indicates the number of previous passwords to block. Valid values 1 to 24.","description_kind":"markdown","optional":true},"password_required":{"type":"bool","description":"Indicates whether a password is required to unlock the device. When TRUE, there must be a password set that unlocks the device for the device to be marked as compliant. When FALSE, a device is marked as compliant whether or not a password is set as required to unlock the device. Default is FALSE.","description_kind":"markdown","optional":true,"computed":true},"password_required_type":{"type":"string","description":"Indicates the password complexity requirement for the device to be marked compliant. Possible values are: deviceDefault, required, numeric, numericComplex, alphabetic, alphanumeric, alphanumericWithSymbols, lowSecurityBiometric, customPassword.","description_kind":"markdown","optional":true,"computed":true},"require_no_pending_system_updates":{"type":"bool","description":"Indicates whether the device has pending security or OS updates and sets the compliance state accordingly. When TRUE, checks if there are any pending system updates on each check in and if there are any pending security or OS version updates (System Updates), the device will be reported as non-compliant. If set to FALSE, then checks for any pending security or OS version updates (System Updates) are done without impact to device compliance state. Default is FALSE.","description_kind":"markdown","optional":true,"computed":true},"role_scope_tag_ids":{"type":["set","string"],"description":"List of Scope Tags for this Entity instance. Inherited from deviceCompliancePolicy","description_kind":"markdown","optional":true,"computed":true},"scheduled_actions_for_rule":{"nested_type":{"attributes":{"rule_name":{"type":"string","description":"Name of the scheduled action rule","description_kind":"markdown","optional":true,"computed":true},"scheduled_action_configurations":{"nested_type":{"attributes":{"action_type":{"type":"string","description":"What action to take. Possible values are: 'noAction', 'notification', 'block', 'retire', 'wipe', 'removeResourceAccessProfiles', 'pushNotification', 'remoteLock'.","description_kind":"markdown","required":true},"grace_period_hours":{"type":"number","description":"Number of hours to wait till the action will be enforced","description_kind":"markdown","optional":true},"notification_message_cc_list":{"type":["list","string"],"description":"A list of group GUIDs to specify who to CC this notification message to","description_kind":"markdown","optional":true},"notification_template_id":{"type":"string","description":"What notification Message template to use","description_kind":"markdown","optional":true}},"nesting_mode":"set"},"description":"The list of scheduled action configurations for this compliance policy","description_kind":"markdown","required":true}},"nesting_mode":"list"},"description":"The list of scheduled action for this rule","description_kind":"markdown","optional":true},"security_block_jailbroken_devices":{"type":"bool","description":"Indicates the device should not be rooted. When TRUE, if the device is detected as rooted it will be reported non-compliant. When FALSE, the device is not reported as non-compliant regardless of device rooted state. Default is FALSE.","description_kind":"markdown","optional":true,"computed":true},"security_require_intune_app_integrity":{"type":"bool","description":"Indicates whether Intune application integrity is required to mark the device as compliant. When TRUE, Intune checks that the Intune app installed on fully managed, dedicated, or corporate-owned work profile Android Enterprise enrolled devices, is the one provided by Microsoft from the Managed Google Play store. If the check fails, the device will be reported as non-compliant. Default is FALSE.","description_kind":"markdown","optional":true,"computed":true},"security_require_safety_net_attestation_basic_integrity":{"type":"bool","description":"Indicates whether the compliance check will validate the Google Play Integrity check. When TRUE, the Google Play integrity basic check must pass to consider the device compliant. When FALSE, the Google Play integrity basic check can pass or fail and the device will be considered compliant. Default is FALSE.","description_kind":"markdown","optional":true,"computed":true},"security_require_safety_net_attestation_certified_device":{"type":"bool","description":"Indicates whether the compliance check will validate the Google Play Integrity check. When TRUE, the Google Play integrity device check must pass to consider the device compliant. When FALSE, the Google Play integrity device check can pass or fail and the device will be considered compliant. Default is FALSE.","description_kind":"markdown","optional":true,"computed":true},"security_required_android_safety_net_evaluation_type":{"type":"string","description":"Indicates the types of measurements and reference data used to evaluate the device SafetyNet evaluation. Evaluation is completed on the device to assess device integrity based on checks defined by Android and built into the device hardware, for example, compromised OS version or root detection. Possible values are: basic, hardwareBacked, with default value of basic.","description_kind":"markdown","optional":true,"computed":true},"storage_require_encryption":{"type":"bool","description":"Indicates whether encryption on Android devices is required to mark the device as compliant.","description_kind":"markdown","optional":true,"computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true}},"description":"Manages Android Device Owner compliance policies using the `/deviceManagement/deviceCompliancePolicies` endpoint. This resource is used to device compliance policies define rules and settings that devices must meet to be considered compliant with organizational security requirements.","description_kind":"markdown"}},"microsoft365_graph_beta_device_management_aosp_device_owner_compliance_policy":{"version":0,"block":{"attributes":{"assignments":{"nested_type":{"attributes":{"filter_id":{"type":"string","description":"ID of the filter to apply to the assignment.","description_kind":"markdown","optional":true,"computed":true},"filter_type":{"type":"string","description":"Type of filter to apply. Must be one of: 'include', 'exclude', or 'none'.","description_kind":"markdown","optional":true,"computed":true},"group_id":{"type":"string","description":"The Entra ID group ID to include or exclude in the assignment. Required when type is 'groupAssignmentTarget' or 'exclusionGroupAssignmentTarget'.","description_kind":"markdown","optional":true},"type":{"type":"string","description":"Type of assignment target. Must be one of: 'allDevicesAssignmentTarget', 'allLicensedUsersAssignmentTarget', 'groupAssignmentTarget', 'exclusionGroupAssignmentTarget'.","description_kind":"markdown","required":true}},"nesting_mode":"set"},"description":"Assignments for the compliance policy. Each assignment specifies the target group and schedule for script execution.","description_kind":"markdown","optional":true},"description":{"type":"string","description":"Optional description of the resource. Maximum length is 1500 characters.","description_kind":"markdown","optional":true,"computed":true},"display_name":{"type":"string","description":"Admin provided name of the device configuration. Inherited from deviceCompliancePolicy","description_kind":"markdown","required":true},"id":{"type":"string","description":"Key of the entity. Inherited from deviceCompliancePolicy","description_kind":"markdown","computed":true},"min_android_security_patch_level":{"type":"string","description":"Minimum Android security patch level.","description_kind":"markdown","optional":true},"os_maximum_version":{"type":"string","description":"Maximum Android version.","description_kind":"markdown","optional":true},"os_minimum_version":{"type":"string","description":"Minimum Android version.","description_kind":"markdown","optional":true},"passcode_minimum_length":{"type":"number","description":"Minimum password length. Valid values 4 to 16","description_kind":"markdown","optional":true},"passcode_minutes_of_inactivity_before_lock":{"type":"number","description":"Minutes of inactivity before a password is required. Valid values 1 to 8640","description_kind":"markdown","optional":true},"passcode_required":{"type":"bool","description":"Require a password to unlock device.","description_kind":"markdown","optional":true,"computed":true},"passcode_required_type":{"type":"string","description":"Type of characters in password. Possible values are: deviceDefault, required, numeric, numericComplex, alphabetic, alphanumeric, alphanumericWithSymbols, lowSecurityBiometric, customPassword.","description_kind":"markdown","optional":true,"computed":true},"role_scope_tag_ids":{"type":["set","string"],"description":"List of Scope Tags for this Entity instance. Inherited from deviceCompliancePolicy","description_kind":"markdown","optional":true,"computed":true},"scheduled_actions_for_rule":{"nested_type":{"attributes":{"rule_name":{"type":"string","description":"Name of the scheduled action rule","description_kind":"markdown","optional":true,"computed":true},"scheduled_action_configurations":{"nested_type":{"attributes":{"action_type":{"type":"string","description":"What action to take. Possible values are: 'noAction', 'notification', 'block', 'retire', 'wipe', 'removeResourceAccessProfiles', 'pushNotification', 'remoteLock'.","description_kind":"markdown","required":true},"grace_period_hours":{"type":"number","description":"Number of hours to wait till the action will be enforced","description_kind":"markdown","optional":true},"notification_message_cc_list":{"type":["list","string"],"description":"A list of group GUIDs to specify who to CC this notification message to","description_kind":"markdown","optional":true},"notification_template_id":{"type":"string","description":"What notification Message template to use","description_kind":"markdown","optional":true}},"nesting_mode":"set"},"description":"The list of scheduled action configurations for this compliance policy","description_kind":"markdown","required":true}},"nesting_mode":"list"},"description":"The list of scheduled action for this rule","description_kind":"markdown","optional":true},"security_block_jailbroken_devices":{"type":"bool","description":"Indicates the device should not be rooted. When TRUE, if the device is detected as rooted it will be reported non-compliant. When FALSE, the device is not reported as non-compliant regardless of device rooted state. Default is FALSE.","description_kind":"markdown","optional":true,"computed":true},"storage_require_encryption":{"type":"bool","description":"Require encryption on Android devices.","description_kind":"markdown","optional":true,"computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true}},"description":"Manages AOSP (Android Open Source Project) device owner compliance policies using the `/deviceManagement/deviceCompliancePolicies` endpoint. This resource is used to device compliance policies define rules and settings that devices must meet to be considered compliant with organizational security requirements.","description_kind":"markdown"}},"microsoft365_graph_beta_device_management_app_control_for_business_built_in_controls":{"version":0,"block":{"attributes":{"additional_rules_for_trusting_apps":{"type":["set","string"],"description":"By default, any devices targeted with this App Control for Business policy will have the setting to Trust Windows components and Store apps enabled, in either audit or enforce mode based on your selection.Further, you can optionally add some additional rules to your policy, such as selecting Trust apps with good reputation to allow reputable apps as defined by the Microsoft Intelligent Security Graph to run.Select Trust apps from managed installers to allow apps deployed via authorized sources of application deployment (managed installers). The Intune management extension will be considered a managed installer if it has been set as such within your organization. Any apps not marked as coming from a managed installer will not be allowed to run.All other apps and files not specified by the rules in this App Control for Business policy will be audited only in local client logs (if Audit only is selected), or blocked (if Enforce is selected) from running on devices. Can include: 'trust_apps_with_good_reputation' - allows reputable apps as defined by the Microsoft Intelligent Security Graph to run; 'trust_apps_from_managed_installers' - allows apps deployed via authorized sources of application deployment (managed installers).","description_kind":"markdown","optional":true,"computed":true},"assignments":{"nested_type":{"attributes":{"filter_id":{"type":"string","description":"ID of the filter to apply to the assignment. Required when filter_type is 'include' or 'exclude'. Should be omitted when filter_type is 'none'.","description_kind":"markdown","optional":true,"computed":true},"filter_type":{"type":"string","description":"Type of filter to apply. Must be one of: 'include', 'exclude', or 'none'.","description_kind":"markdown","optional":true,"computed":true},"group_id":{"type":"string","description":"The Entra ID group ID to include or exclude in the assignment. Required when type is 'groupAssignmentTarget' or 'exclusionGroupAssignmentTarget'.","description_kind":"markdown","optional":true},"type":{"type":"string","description":"Type of assignment target. Must be one of: 'allDevicesAssignmentTarget', 'allLicensedUsersAssignmentTarget', 'groupAssignmentTarget', 'exclusionGroupAssignmentTarget'.","description_kind":"markdown","required":true}},"nesting_mode":"set"},"description":"Assignments for the device configuration. Each assignment specifies the target group and schedule for script execution. Supports group filters.","description_kind":"markdown","optional":true},"description":{"type":"string","description":"Optional description of the resource. Maximum length is 1500 characters.","description_kind":"markdown","optional":true,"computed":true},"enable_app_control":{"type":"string","description":"Select Audit only to log all events in local client logs but not block any apps from running or select Enforce to actively block apps from running in a deployed App Control for Business base policy. App Control for Business policies created in either Audit only or Enforce mode will be deployed as rebootless base policies to all devices targeted. By default, any devices targeted with this App Control for Business policy will have the setting to Trust Windows components and Store apps enabled, in either audit or enforce mode based on your selection.","description_kind":"markdown","required":true},"id":{"type":"string","description":"The unique identifier of the app control for business status.","description_kind":"markdown","computed":true},"name":{"type":"string","description":"Name of the App Control for Business policy.","description_kind":"markdown","required":true},"role_scope_tag_ids":{"type":["set","string"],"description":"Set of scope tag IDs for this App Control for Business policy.","description_kind":"markdown","optional":true,"computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true}},"description":"Manages App Control for Business configuration policies using the `/deviceManagement/configurationPolicies` endpoint. This resource is used to app Control for Business policies enable application control and trust settings on Windows devices with configurable enforcement modes and trusted application sources.","description_kind":"markdown"}},"microsoft365_graph_beta_device_management_app_control_for_business_policy":{"version":0,"block":{"attributes":{"assignments":{"nested_type":{"attributes":{"filter_id":{"type":"string","description":"ID of the filter to apply to the assignment. Required when filter_type is 'include' or 'exclude'. Should be omitted when filter_type is 'none'.","description_kind":"markdown","optional":true,"computed":true},"filter_type":{"type":"string","description":"Type of filter to apply. Must be one of: 'include', 'exclude', or 'none'.","description_kind":"markdown","optional":true,"computed":true},"group_id":{"type":"string","description":"The Entra ID group ID to include or exclude in the assignment. Required when type is 'groupAssignmentTarget' or 'exclusionGroupAssignmentTarget'.","description_kind":"markdown","optional":true},"type":{"type":"string","description":"Type of assignment target. Must be one of: 'allDevicesAssignmentTarget', 'allLicensedUsersAssignmentTarget', 'groupAssignmentTarget', 'exclusionGroupAssignmentTarget'.","description_kind":"markdown","required":true}},"nesting_mode":"set"},"description":"Assignments for the device configuration. Each assignment specifies the target group and schedule for script execution. Supports group filters.","description_kind":"markdown","optional":true},"description":{"type":"string","description":"Optional description of the resource. Maximum length is 1500 characters.","description_kind":"markdown","optional":true,"computed":true},"id":{"type":"string","description":"The unique identifier of the app control for business policy.","description_kind":"markdown","computed":true},"name":{"type":"string","description":"Name of the App Control for Business policy.","description_kind":"markdown","required":true},"policy_xml":{"type":"string","description":"The XML content of the App Control for Business policy. When you create policies for use with App Control for Business, start from an existing base policy and then add or remove rules to build your own custom policy. Windows includes several example policies that you can use. These example policies are provided by microsoft 'as-is'. You should thoroughly test the policies you deploy using safe deployment methods. These base policies can be found on Windows 11 22H2 and later devices. The locations of these policies can be found [here](https://learn.microsoft.com/en-us/windows/security/application-security/application-control/app-control-for-business/design/example-appcontrol-base-policies). For more information on policy rules and file rules, please see the [Understand App Control for Business policy rules and file rules](https://learn.microsoft.com/en-us/windows/security/application-security/application-control/app-control-for-business/design/select-types-of-rules-to-create).However, if you prefer an easier method, you should try the community-based tool [AppControl Manager](https://github.com/HotCakeX/Harden-Windows-Security/wiki/AppControl-Manager)","description_kind":"markdown","required":true},"role_scope_tag_ids":{"type":["set","string"],"description":"Set of scope tag IDs for this App Control for Business policy.","description_kind":"markdown","optional":true,"computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true}},"description":"Manages App Control for Business configuration policies with custom XML content using the `/deviceManagement/configurationPolicies` endpoint. This resource is used to deploy custom App Control for Business policies by providing XML policy content directly.","description_kind":"markdown"}},"microsoft365_graph_beta_device_management_apple_configurator_enrollment_policy":{"version":0,"block":{"attributes":{"configuration_endpoint_url":{"type":"string","description":"Apple Configurator enrollment configuration endpoint URL generated by Intune.","description_kind":"markdown","computed":true},"dep_onboarding_settings_id":{"type":"string","description":"Identifier of the parent depOnboardingSetting that contains this apple business manager enrollment profile. This is resolved from the /deviceManagement endpoint and correlated to the intuneAccountId.","description_kind":"markdown","computed":true},"description":{"type":"string","description":"Optional description of the resource. Maximum length is 1500 characters.","description_kind":"markdown","optional":true,"computed":true},"display_name":{"type":"string","description":"The name of the apple business manager enrollment profile displayed in Intune.","description_kind":"markdown","required":true},"enable_authentication_via_company_portal":{"type":"bool","description":"How users first sign in to authenticate with Intune.If your organization uses multi-factor authentication, set this to true; the app will then automatically install on devices at time of enrollment. ","description_kind":"markdown","required":true},"id":{"type":"string","description":"The unique identifier of the enrollment profile.","description_kind":"markdown","computed":true},"require_company_portal_on_setup_assistant_enrolled_devices":{"type":"bool","description":"How users first sign in to authenticate with Intune. Setup assistant as a standalone authentication method has been superseded by setup assistant with modern authentication. The modern authentication method prompts users to authenticate based on the settings you've configured in Microsoft Entra ID.","description_kind":"markdown","required":true},"requires_user_authentication":{"type":"bool","description":"Indicates whether the user must authenticate during Apple device setup.","description_kind":"markdown","required":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true}},"description":"Manages apple configurator enrollment policies using the `/deviceManagement/depOnboardingSettings/{depOnboardingSettingsId}/enrollmentProfiles` endpoint. This resource is used to configure apple configurator enrollment policies settings.","description_kind":"markdown"}},"microsoft365_graph_beta_device_management_apple_user_initiated_enrollment_profile_assignment":{"version":0,"block":{"attributes":{"apple_user_initiated_enrollment_profile_id":{"type":"string","description":"The ID of the Apple User Initiated Enrollment Profile to attach the assignment to.","description_kind":"plain","required":true},"id":{"type":"string","description":"The ID of the Apple User Initiated Enrollment Profile assignment.","description_kind":"markdown","computed":true},"target":{"nested_type":{"attributes":{"device_and_app_management_assignment_filter_id":{"type":"string","description":"The Id of the scope filter applied to the target assignment.","description_kind":"markdown","optional":true},"device_and_app_management_assignment_filter_type":{"type":"string","description":"The type of scope filter for the target assignment. Defaults to 'none'. Possible values are:\n\n- **include**: Only include devices or users matching the filter\n- **exclude**: Exclude devices or users matching the filter\n- **none**: No assignment filter applied","description_kind":"markdown","optional":true,"computed":true},"entra_object_id":{"type":"string","description":"The Entra Object ID for the assignment target. Required for 'user' and 'group' target types.","description_kind":"markdown","optional":true},"group_id":{"type":"string","description":"The Entra ID group ID for the assignment target. Required when target_type is 'group' or 'exclusionGroup'.","description_kind":"markdown","optional":true},"target_type":{"type":"string","description":"The target type for the Apple User Initiated Enrollment Profile assignment. Possible values are:\n\n- **user**: Target specific users (uses GroupAssignmentTarget with user ID)\n- **group**: Target a specific Entra ID group\n- **exclusionGroup**: Target a specific Entra ID group for exclusion\n- **allUsers**: Target all licensed users in the tenant","description_kind":"markdown","required":true}},"nesting_mode":"single"},"description_kind":"plain","required":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true}},"description":"Manages Apple User Initiated Enrollment Profile Assignments in Microsoft Intune.","description_kind":"plain"}},"microsoft365_graph_beta_device_management_assignment_filter":{"version":0,"block":{"attributes":{"assignment_filter_management_type":{"type":"string","description":"Indicates filter is applied to either 'devices' or 'apps' management type. Possible values are: devices, apps, unknownFutureValue. Default filter will be applied to 'devices'.","description_kind":"plain","optional":true,"computed":true},"created_date_time":{"type":"string","description":"The creation time of the assignment filter.","description_kind":"plain","computed":true},"description":{"type":"string","description":"Optional description of the resource. Maximum length is 1500 characters.","description_kind":"markdown","optional":true,"computed":true},"display_name":{"type":"string","description":"The display name of the assignment filter.","description_kind":"plain","required":true},"id":{"type":"string","description":"The unique identifier of the assignment filter.","description_kind":"markdown","computed":true},"last_modified_date_time":{"type":"string","description":"Last modified time of the assignment filter.","description_kind":"plain","computed":true},"platform":{"type":"string","description":"The Intune device management type (platform) for the assignment filter. This specifies the OS platform type for which the assignment filter will be applied.Must be one of the following values: android, androidForWork, iOS, macOS, windows10AndLater,androidAOSP, androidMobileApplicationManagement, iOSMobileApplicationManagement, windowsMobileApplicationManagement.","description_kind":"plain","required":true},"role_scope_tags":{"type":["set","string"],"description":"Set of scope tag IDs for this Settings Catalog template profile.","description_kind":"markdown","optional":true,"computed":true},"rule":{"type":"string","description":"Rule definition of the assignment filter.","description_kind":"plain","required":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true}},"description":"Manages assignment filters using the `/deviceManagement/assignmentFilters` endpoint. This resource is used to assignment filters enable granular targeting of policies and applications based on device properties like OS version, manufacturer, device name, or custom attributes, allowing more precise deployment control beyond basic group membership. You can learn more about assignment filters [here](https://learn.microsoft.com/en-us/intune/intune-service/fundamentals/filters-device-properties)..","description_kind":"markdown"}},"microsoft365_graph_beta_device_management_device_category":{"version":0,"block":{"attributes":{"description":{"type":"string","description":"Optional description of the resource. Maximum length is 1500 characters.","description_kind":"markdown","optional":true,"computed":true},"display_name":{"type":"string","description":"The display name of the Intune device category","description_kind":"plain","required":true},"id":{"type":"string","description":"The unique identifier for this Intune device category","description_kind":"markdown","computed":true},"role_scope_tag_ids":{"type":["set","string"],"description":"Set of scope tag IDs for this Settings Catalog template profile.","description_kind":"markdown","optional":true,"computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit 