ch as Outlook for Windows and Outlook on the web; otherwise false. Default value is false.","description_kind":"markdown","computed":true},"id":{"type":"string","description":"The unique identifier for the group.","description_kind":"markdown","computed":true},"mail":{"type":"string","description":"The SMTP address for the group.","description_kind":"markdown","computed":true},"mail_enabled":{"type":"bool","description":"Whether the group is mail-enabled. Can be used as an additional filter when combined with other lookup attributes.","description_kind":"markdown","optional":true,"computed":true},"mail_nickname":{"type":"string","description":"The mail alias for the group, unique in the organisation. One of `object_id`, `display_name`, or `mail_nickname` must be specified.","description_kind":"markdown","optional":true,"computed":true},"members":{"type":["set","string"],"description":"List of object IDs of the group members.","description_kind":"markdown","computed":true},"membership_rule":{"type":"string","description":"The rule that determines members for a dynamic membership group. Only populated when `dynamic_membership_enabled` is `true`.","description_kind":"markdown","computed":true},"membership_rule_processing_state":{"type":"string","description":"Indicates whether the dynamic membership is processing. Possible values are:\n  - `On`: Dynamic membership is active\n  - `Paused`: Dynamic membership is paused","description_kind":"markdown","computed":true},"object_id":{"type":"string","description":"The object ID of the group. One of `object_id`, `display_name`, `mail_nickname`, or `odata_query` must be specified.","description_kind":"markdown","optional":true,"computed":true},"odata_query":{"type":"string","description":"Custom OData filter query. Use this for advanced filtering when the standard lookup attributes don't meet your needs. Cannot be combined with `object_id`, `display_name`, or `mail_nickname`. Example: `displayName eq 'My Group' and securityEnab