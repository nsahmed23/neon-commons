nce requirements and provide custom compliance assessments.","description_kind":"markdown"}},"microsoft365_graph_beta_device_management_windows_driver_update_inventory":{"version":0,"block":{"attributes":{"applicable_device_count":{"type":"number","description":"The number of devices for which this driver is applicable.","description_kind":"markdown","computed":true},"approval_status":{"type":"string","description":"The approval status for this driver. Possible values are: `needsReview`, `declined`, `approved`, `suspended`.","description_kind":"markdown","required":true},"category":{"type":"string","description":"The category for this driver. Possible values are: `recommended`, `previouslyApproved`, `other`.","description_kind":"markdown","required":true},"deploy_date_time":{"type":"string","description":"The date time when a driver should be deployed if approvalStatus is approved.","description_kind":"markdown","optional":true},"driver_class":{"type":"string","description":"The class of the driver.","description_kind":"markdown","optional":true},"id":{"type":"string","description":"The id of the driver.","description_kind":"markdown","computed":true},"manufacturer":{"type":"string","description":"The manufacturer of the driver.","description_kind":"markdown","required":true},"name":{"type":"string","description":"The name of the driver.","description_kind":"markdown","required":true},"release_date_time":{"type":"string","description":"The release date time of the driver.","description_kind":"markdown","optional":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/