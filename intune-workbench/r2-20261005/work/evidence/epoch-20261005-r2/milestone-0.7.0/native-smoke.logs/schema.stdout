 'Success', 'Failure', 'ClientError', 'Timeout').","description_kind":"markdown","computed":true},"activity_type":{"type":"string","description":"The type of activity that was performed, such as 'Delete CloudPcOnPremisesConnection'.","description_kind":"markdown","computed":true},"actor":{"nested_type":{"attributes":{"application_display_name":{"type":"string","description":"The display name of the application.","description_kind":"markdown","computed":true},"application_id":{"type":"string","description":"The Microsoft Entra application ID of the actor.","description_kind":"markdown","computed":true},"ip_address":{"type":"string","description":"The IP address from which the activity was performed, if available.","description_kind":"markdown","computed":true},"remote_tenant_id":{"type":"string","description":"The delegated partner tenant ID, if applicable.","description_kind":"markdown","computed":true},"remote_user_id":{"type":"string","description":"The delegated partner user ID, if applicable.","description_kind":"markdown","computed":true},"service_principal_name":{"type":"string","description":"The service principal name (SPN) of the actor, if applicable.","description_kind":"markdown","computed":true},"type":{"type":"string","description":"The type of actor (e.g., 'application', 'itPro', 'partner').","description_kind":"markdown","computed":true},"user_id":{"type":"string","description":"The Microsoft Entra user ID of the actor.","description_kind":"markdown","computed":true},"user_permissions":{"type":["list","string"],"description":"List of user and application permissions at the time of the event.","description_kind":"markdown","computed":true},"user_principal_name":{"type":"string","description":"The user principal name (UPN) of the actor, if applicable.","description_kind":"markdown","computed":true},"user_role_scope_tags":{"nested_type":{"attributes":{"display_name":{"type":"string","description":"The display name of the role scope tag.","description_kin