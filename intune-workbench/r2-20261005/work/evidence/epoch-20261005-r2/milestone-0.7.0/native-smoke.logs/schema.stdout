arkdown","required":true},"payload":{"type":"string","description":"The macOS configuration payload (.mobileconfig / .plist) file content.","description_kind":"markdown","required":true},"payload_file_name":{"type":"string","description":"The profile name displayed to users.","description_kind":"markdown","required":true},"payload_name":{"type":"string","description":"The name of the payload configuration.","description_kind":"markdown","required":true}},"nesting_mode":"single"},"description":"The custom configuration template allows IT admins to assign settings that aren't built into Intune yet. For macOS devices, you can import a .mobileconfig file that you created using Profile Manager or a different tool.","description_kind":"markdown","optional":true},"description":{"type":"string","description":"Optional description of the resource. Maximum length is 1500 characters.","description_kind":"markdown","optional":true,"computed":true},"display_name":{"type":"string","description":"The display name for the macOS configuration template.","description_kind":"markdown","required":true},"id":{"type":"string","description":"The unique identifier for the macOS configuration template.","description_kind":"markdown","computed":true},"pkcs_certificate":{"nested_type":{"attributes":{"allow_all_apps_access":{"type":"bool","description":"Whether to allow all applications to access the certificate.","description_kind":"markdown","optional":true},"certificate_store":{"type":"string","description":"The certificate store location. Possible values are: user, machine.","description_kind":"markdown","optional":true},"certificate_template_name":{"type":"string","description":"The certificate template name for PKCS certificates.","description_kind":"markdown","optional":true},"certificate_validity_period_scale":{"type":"string","description":"The certificate validity period scale. Possible values are: days, months, years.","description_kind":"markdown","optional":true},"certificate_validity_period_value":{"type":"number","description":"The certificate validity period value.","description_kind":"markdown","optional":true},"certification_authority":{"type":"string","description":"The certification authority for PKCS certificates.","description_kind":"markdown","optional":true},"certification_authority_name":{"type":"string","description":"The certification authority name for PKCS certificates.","description_kind":"markdown","optional":true},"custom_subject_alternative_names":{"nested_type":{"attributes":{"name":{"type":"string","description":"The SAN value/name.","description_kind":"markdown","required":true},"san_type":{"type":"string","description":"The SAN type. Possible values are: emailAddress, userPrincipalName, customAzureADAttribute, domainNameService, universalResourceIdentifier.","description_kind":"markdown","required":true}},"nesting_mode":"set"},"description":"Custom Subject Alternative Names for the certificate.","description_kind":"markdown","optional":true},"deployment_channel":{"type":"string","description":"The deployment channel for the certificate. Possible values are: deviceChannel, userChannel.","description_kind":"markdown","optional":true,"computed":true},"renewal_threshold_percentage":{"type":"number","description":"The certificate renewal threshold percentage (1-99).","description_kind":"markdown","optional":true},"subject_name_format":{"type":"string","description":"Defaults to custom.","description_kind":"markdown","required":true},"subject_name_format_string":{"type":"string","description":"Custom format to use with SubjectNameFormat = Custom. Example: CN={{AAD_Device_ID}},O={{Organization}}","description_kind":"markdown","optional":true}},"nesting_mode":"single"},"description":"PKCS certificate profile configuration for macOS devices.","description_kind":"markdown","optional":true},"preference_file":{"nested_type":{"attributes":{"bundle_id":{"type":"string","description":"The bundle ID (Preference domain name) of the application this preference file applies to. Typically in the format com.company.appname.","description_kind":"markdown","required":true},"configuration_xml":{"type":"string","description":"The base64-encoded XML configuration content (.plist file content).","description_kind":"markdown","required":true},"file_name":{"type":"string","description":"The file name of the preference file (.plist file).","description_kind":"markdown","required":true}},"nesting_mode":"single"},"description":"Configure a preference file that uses the standard property list (.plist) format to define preferences for apps and the device.","description_kind":"markdown","optional":true},"role_scope_tag_ids":{"type":["set","string"],"description":"Set of scope tag IDs for this Settings Catalog template profile.","description_kind":"markdown","optional":true,"computed":true},"scep_certificate":{"nested_type":{"attributes":{"allow_all_apps_access":{"type":"bool","description":"Whether to allow all applications to access the certificate.","description_kind":"markdown","optional":true},"certificate_store":{"type":"string","description":"The certificate store location. Possible values are: user, machine.","description_kind":"markdown","optional":true},"certificate_validity_period_scale":{"type":"string","description":"The certificate validity period scale. Possible values are: days, months, years.","description_kind":"markdown","required":true},"certificate_validity_period_value":{"type":"number","description":"The certificate validity period value.","description_kind":"markdown","required":true},"custom_subject_alternative_names":{"nested_type":{"attributes":{"name":{"type":"string","description":"The SAN value/name.","description_kind":"markdown","required":true},"san_type":{"type":"string","description":"The SAN type. Possible values are: emailAddress, userPrincipalName, customAzureADAttribute, domainNameService, universalResourceIdentifier.","description_kind":"markdown","required":true}},"nesting_mode":"set"},"description":"Custom Subject Alternative Names for the certificate.","description_kind":"markdown","optional":true},"deployment_channel":{"type":"string","description":"The deployment channel for the certificate. Possible values are: deviceChannel, userChannel.","description_kind":"markdown","required":true},"extended_key_usages":{"nested_type":{"attributes":{"name":{"type":"string","description":"The extended key usage name.","description_kind":"markdown","required":true},"object_identifier":{"type":"string","description":"The extended key usage object identifier (OID).","description_kind":"markdown","required":true}},"nesting_mode":"set"},"description":"Extended key usage settings for the certificate.","description_kind":"markdown","required":true},"key_size":{"type":"string","description":"The key size in bits for the certificate.2048 is the recommended minimum key length.Possible values are: size1024, size2048, size4096.","description_kind":"markdown","required":true},"key_usage":{"type":["set","string"],"description":"Key usage options for the certificate. Possible values are: keyEncipherment, digitalSignature.","description_kind":"markdown","required":true},"renewal_threshold_percentage":{"type":"number","description":"The certificate renewal threshold percentage (1-99).","description_kind":"markdown","required":true},"root_certificate_odata_bind":{"type":"string","description":"Reference to the pre existing trusted root certificate configuration for the odata bind.Valid format is \"https://graph.microsoft.com/beta/deviceManagement/deviceConfigurations('00000000-0000-0000-0000-000000000000')\".Or you can supply just the ID of the certificate configuration. e.g. '00000000-0000-0000-0000-000000000000'","description_kind":"markdown","required":true},"scep_server_urls":{"type":["set","string"],"description":"SCEP server URL(s) for certificate enrollment.","description_kind":"markdown","optional":true},"subject_name_format":{"type":"string","description":"Defaults to custom.","description_kind":"markdown","required":true},"subject_name_format_string":{"type":"string","description":"Select how Intune automatically creates the subject name in the certificate request. If the certificate is for a user, you can also include the user's email address in the subject name. Please review subject name documentation 'https://learn.microsoft.com/en-us/intune/intune-service/protect/certificates-profile-scep'on how to best use the Subject name format field.Custom. Example: CN={{AAD_Device_ID}},O={{Organization}}","description_kind":"markdown","required":true}},"nesting_mode":"single"},"description":"SCEP certificate profile configuration for macOS devices.","description_kind":"markdown","optional":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true},"trusted_certificate":{"nested_type":{"attributes":{"cert_file_name":{"type":"string","description":"The file name of the certificate file (.cer file).","description_kind":"markdown","required":true},"deployment_channel":{"type":"string","description":"The deployment channel for the certificate. Possible values are: deviceChannel, userChannel.","description_kind":"markdown","required":true},"trusted_root_certificate":{"type":"string","description":"The base64-encoded trusted root certificate content. This should be a filebase64() encoded string. e.g filebase64(\"my-root-cert.cer\")","description_kind":"markdown","required":true}},"nesting_mode":"single"},"description":"Trusted root certificate configuration for macOS devices.","description_kind":"markdown","optional":true}},"description":"Manages macOS configuration templates in Microsoft Intune. This resource creates device configurations for macOS devices including custom configuration profiles, preference files, trusted certificates, and certificate profiles (SCEP/PKCS).","description_kind":"markdown"}},"microsoft365_graph_beta_device_management_macos_device_enrollment_policy":{"version":0,"block":{"attributes":{"accessibility_screen_disabled":{"type":"bool","description":"Whether to hide the Accessibility pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"admin_account":{"nested_type":{"attributes":{"create_local_admin_account":{"type":"bool","description":"Whether Setup Assistant creates a local administrator account.","description_kind":"markdown","required":true},"create_local_primary_account":{"type":"bool","description":"Whether Setup Assistant also creates a separate, standard (non-admin) local primary account.","description_kind":"markdown","required":true},"full_name":{"type":"string","description":"The full name for the local administrator account.","description_kind":"markdown","optional":true},"hide_account":{"type":"bool","description":"Whether to hide the local administrator account from the login window and Users \u0026 Groups.","description_kind":"markdown","optional":true,"computed":true},"password_rotation_in_days":{"type":"number","description":"Automatic rotation period, in days, for the local administrator account password. `0` disables rotation.","description_kind":"markdown","optional":true,"computed":true},"primary_account":{"nested_type":{"attributes":{"full_name":{"type":"string","description":"The full name to prefill for the primary account. Only applicable when `prefill_account_info` is `true`.","description_kind":"markdown","optional":true},"prefill_account_info":{"type":"bool","description":"Whether to prefill the primary account name/full name in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"restrict_editing":{"type":"bool","description":"Whether to prevent the user from editing the prefilled primary account information. Only applicable when `prefill_account_info` is `true`.","description_kind":"markdown","optional":true,"computed":true},"user_name":{"type":"string","description":"The account (short) name to prefill for the primary account. Only applicable when `prefill_account_info` is `true`.","description_kind":"markdown","optional":true}},"nesting_mode":"single"},"description":"Standard local account settings. Only applicable when `create_local_primary_account` is `true`.","description_kind":"markdown","optional":true},"user_name":{"type":"string","description":"The account (short) name for the local administrator account.","description_kind":"markdown","optional":true}},"nesting_mode":"single"},"description":"Local account settings created during Setup Assistant. Required when `await_device_configured` is `true`, and must be omitted when it is `false`.","description_kind":"markdown","optional":true},"app_store_disabled":{"type":"bool","description":"Whether to hide the App Store pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"apple_id_disabled":{"type":"bool","description":"Whether to hide the Apple ID sign-in pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"apple_intelligence_disabled":{"type":"bool","description":"Whether to hide the Apple Intelligence pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"apple_pay_disabled":{"type":"bool","description":"Whether to hide the Apple Pay pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"auto_unlock_with_watch_disabled":{"type":"bool","description":"Whether to hide the Unlock with Apple Watch pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"await_device_configured":{"type":"bool","description":"Whether `admin_account` configures a local account. When `true`, `admin_account` is required; when `false`, it must be omitted and no local account is created. Confirmed against live Intune admin center traffic: the underlying `ade_macos_awaitconfiguration` setting is always sent as active, with the actual create/don't-create choice carried entirely by `admin_account.create_local_admin_account`.","description_kind":"markdown","optional":true,"computed":true},"created_date_time":{"type":"string","description":"Creation date and time of the policy.","description_kind":"markdown","computed":true},"dep_onboarding_settings_id":{"type":"string","description":"The ID of the Apple ABM/ASM DEP onboarding token (`/deviceManagement/depOnboardingSettings`) that owns this profile. If omitted, it is automatically resolved to the tenant's single Apple ADE/ABM (or ASM) token; if the tenant has more than one Apple token, this must be set explicitly.","description_kind":"markdown","optional":true,"computed":true},"description":{"type":"string","description":"Optional description of the resource. Maximum length is 1500 characters.","description_kind":"markdown","optional":true,"computed":true},"device_security_group":{"type":"string","description":"The ID of the static Microsoft Entra security group to use for enrollment time grouping (the \"Device group\" tab in the Intune admin center policy wizard). Devices assigned this policy become members of the group as they enroll. This is set via the dedicated `setEnrollmentTimeDeviceMembershipTarget` action on `/deviceManagement/configurationPolicies/{id}` (and cleared via `clearEnrollmentTimeDeviceMembershipTarget` when removed), not via the settings catalog. The group must have the 'Intune Provisioning Client' service principal (AppId: f1346770-5b25-470b-88bd-d5744ab7952c) set as its owner; in some tenants this service principal may appear as 'Intune Autopilot ConfidentialClient'.\n\n~\u003e **Known Microsoft Graph limitation:** as of this writing, `setEnrollmentTimeDeviceMembershipTarget` and `clearEnrollmentTimeDeviceMembershipTarget` return an `Internal Server Error - 500` from the Intune backend (`DeviceConfigV2`) when called with application permissions (client credentials) - the auth flow this provider always uses. The identical request succeeds when made with delegated (signed-in user) permissions, e.g. from the Intune admin center. Until Microsoft resolves this for application permissions, setting `device_security_group` through this provider will fail on `Create` and `Update`; this is a Microsoft Graph service limitation, not a provider defect.","description_kind":"markdown","optional":true},"diagnostics_disabled":{"type":"bool","description":"Whether to hide the Diagnostics pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"display_tone_setup_disabled":{"type":"bool","description":"Whether to hide the Appearance (display tone) pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"enable_authentication_via_company_portal":{"type":"bool","description":"Whether Setup Assistant authenticates the user via Company Portal. Only applicable when `requires_user_authentication` is `true`, in which case exactly one of this or `require_company_portal_on_setup_assistant_enrolled_devices` must be `true`. Mutually exclusive with `require_company_portal_on_setup_assistant_enrolled_devices`.","description_kind":"markdown","optional":true,"computed":true},"file_vault_disabled":{"type":"bool","description":"Whether to hide the FileVault pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"icloud_diagnostics_disabled":{"type":"bool","description":"Whether to hide the iCloud Analytics pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"icloud_storage_disabled":{"type":"bool","description":"Whether to hide the iCloud Storage pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"id":{"type":"string","description":"The unique identifier for this policy.","description_kind":"markdown","computed":true},"is_assigned":{"type":"bool","description":"Indicates if the policy is assigned to any scope.","description_kind":"markdown","computed":true},"is_default_policy_assignment":{"type":"bool","description":"Whether this policy is the default macOS enrollment profile for its `dep_onboarding_settings_id`, set via the dedicated `setDefaultProfile` action. Always reflects the DEP token's actual current default on refresh, regardless of configuration.\n\n~\u003e **No unassign action:** Microsoft Graph does not expose an `unsetDefaultProfile`/`clearDefaultProfile` action - `setDefaultProfile` is the only operation available. Setting this to `false` on a policy that is currently the DEP token's default has no effect on Graph; the next refresh reports `true` again. Only setting a different policy's `is_default_policy_assignment` to `true` changes which profile is the default. A change from `true` to `false` while this policy is still the token's current default can therefore never converge, and the provider rejects the update with a validation error. Promote the replacement policy first - in the same apply, give this policy a `depends_on` for the replacement so the promotion runs first, or apply the promotion separately.","description_kind":"markdown","optional":true,"computed":true},"last_modified_date_time":{"type":"string","description":"Last modification date and time of the policy.","description_kind":"markdown","computed":true},"location_services_disabled":{"type":"bool","description":"Whether to hide the Location Services pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"lockdown_mode_disabled":{"type":"bool","description":"Whether to hide the Lockdown Mode pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"locked_enrollment_enabled":{"type":"bool","description":"Whether enrollment is locked to the authorized user/device, preventing the MDM profile from being removed before enrollment completes.","description_kind":"markdown","optional":true,"computed":true},"name":{"type":"string","description":"The display name of the enrollment profile.","description_kind":"markdown","required":true},"os_showcase_screen_disabled":{"type":"bool","description":"Whether to hide the What's New (OS showcase) pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"platforms":{"type":"string","description":"The platforms this policy applies to. Always `macOS`.","description_kind":"markdown","computed":true},"privacy_pane_disabled":{"type":"bool","description":"Whether to hide the Privacy pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"require_company_portal_on_setup_assistant_enrolled_devices":{"type":"bool","description":"Whether Company Portal is required on Setup Assistant enrolled devices. Only applicable when `requires_user_authentication` is `true`, in which case exactly one of this or `enable_authentication_via_company_portal` must be `true`. Mutually exclusive with `enable_authentication_via_company_portal`.","description_kind":"markdown","optional":true,"computed":true},"requires_user_authentication":{"type":"bool","description":"Whether the enrollment requires user authentication (user affinity). When `false`, the device enrolls without an associated user (shared/kiosk device path). When `true`, exactly one of `enable_authentication_via_company_portal` or `require_company_portal_on_setup_assistant_enrolled_devices` must also be `true` - Microsoft Graph rejects the enrollment profile otherwise.","description_kind":"markdown","required":true},"restore_disabled":{"type":"bool","description":"Whether to hide the Restore from Backup pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"role_scope_tag_ids":{"type":["set","string"],"description":"Set of scope tag IDs for this Settings Catalog template profile.","description_kind":"markdown","optional":true,"computed":true},"screen_time_screen_disabled":{"type":"bool","description":"Whether to hide the Screen Time pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"settings_count":{"type":"number","description":"Number of settings within the policy.","description_kind":"markdown","computed":true},"siri_disabled":{"type":"bool","description":"Whether to hide the Siri pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"software_update_completed_screen_disabled":{"type":"bool","description":"Whether to hide the post-installation Software Update Completed pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"software_update_screen_disabled":{"type":"bool","description":"Whether to hide the Software Update pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"support_department":{"type":"string","description":"The department name shown to the user on the Setup Assistant Remote Management pane. Must be between 1 and 125 characters.","description_kind":"markdown","required":true},"support_phone_number":{"type":"string","description":"The support phone number shown to the user on the Setup Assistant Remote Management pane. Must be between 1 and 125 characters.","description_kind":"markdown","required":true},"technologies":{"type":"string","description":"The technology this policy is using. Always `enrollment`.","description_kind":"markdown","computed":true},"template_family":{"type":"string","description":"The template family for this policy (`enrollmentConfiguration`).","description_kind":"markdown","computed":true},"template_id":{"type":"string","description":"The settings catalog template ID used by this policy.","description_kind":"markdown","computed":true},"terms_and_conditions_disabled":{"type":"bool","description":"Whether to hide the Terms and Conditions pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"terms_of_address_screen_disabled":{"type":"bool","description":"Whether to hide the Terms of Address pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true},"touch_id_disabled":{"type":"bool","description":"Whether to hide the Touch ID/Face ID pane in Setup Assistant.","description_kind":"markdown","optional":true,"computed":true}},"description":"Manages a macOS Automated Device Enrollment (ADE) profile using the `/deviceManagement/configurationPolicies` settings catalog endpoint. This is the modern, settings-catalog-backed equivalent of the legacy `depMacOSEnrollmentProfile` API (see `microsoft365_graph_beta_device_management_macos_dep_enrollment_profile`), and controls macOS Setup Assistant behavior for devices enrolled via Apple Business Manager / Apple School Manager.","description_kind":"markdown"}},"microsoft365_graph_beta_device_management_macos_platform_script":{"version":0,"block":{"attributes":{"assignments":{"nested_type":{"attributes":{"group_id":{"type":"string","description":"The Entra ID group ID to include or exclude in the assignment. Required when type is 'groupAssignmentTarget' or 'exclusionGroupAssignmentTarget'.","description_kind":"markdown","optional":true},"type":{"type":"string","description":"Type of assignment target. Must be one of: 'allDevicesAssignmentTarget', 'allLicensedUsersAssignmentTarget', 'groupAssignmentTarget', 'exclusionGroupAssignmentTarget'.","description_kind":"markdown","required":true}},"nesting_mode":"set"},"description":"Assignments for the Windows remediation script. Each assignment specifies the target group and schedule for script execution.","description_kind":"markdown","optional":true},"block_execution_notifications":{"type":"bool","description":"Does not notify the user a script is being executed.","description_kind":"markdown","optional":true,"computed":true},"description":{"type":"string","description":"Optional description of the resource. Maximum length is 1500 characters.","description_kind":"markdown","optional":true,"computed":true},"display_name":{"type":"string","description":"Name of the macOS Platform Script.","description_kind":"markdown","required":true},"execution_frequency":{"type":"string","description":"The interval for script to run in ISO 8601 duration format (e.g., PT1H for 1 hour, P1D for 1 day). If not defined the script will run once.","description_kind":"markdown","optional":true,"computed":true},"file_name":{"type":"string","description":"Script file name.","description_kind":"markdown","required":true},"id":{"type":"string","description":"The unique identifier of the macOS platform script.","description_kind":"markdown","computed":true},"retry_count":{"type":"number","description":"Number of times for the script to be retried if it fails.","description_kind":"markdown","optional":true,"computed":true},"role_scope_tag_ids":{"type":["set","string"],"description":"Set of scope tag IDs for this Settings Catalog template profile.","description_kind":"markdown","optional":true,"computed":true},"run_as_account":{"type":"string","description":"Indicates the type of execution context. Possible values are: `system`, `user`.","description_kind":"markdown","required":true},"script_content":{"type":"string","description":"The script content. Can be either inline or a file path. If a file path is provided, the file will be read and the content will be used as the script content.","description_kind":"markdown","required":true,"sensitive":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true}},"description":"Manages macOS shell scripts using the `/deviceManagement/deviceShellScripts` endpoint. This resource is used to macOS platform scripts enable automated deployment and execution of shell scripts on managed macOS devices with support for scheduled execution, retry logic, and execution context control for system maintenance and configuration tasks.","description_kind":"markdown"}},"microsoft365_graph_beta_device_management_macos_software_update_configuration":{"version":0,"block":{"attributes":{"all_other_update_behavior":{"type":"string","description":"Update behavior for all other updates. Possible values: `notConfigured`, `default`, `downloadOnly`, `installASAP`, `notifyOnly`, `installLater`.","description_kind":"markdown","required":true},"assignments":{"nested_type":{"attributes":{"group_id":{"type":"string","description":"The Entra ID group ID to include or exclude in the assignment. Required when type is 'groupAssignmentTarget' or 'exclusionGroupAssignmentTarget'.","description_kind":"markdown","optional":true},"type":{"type":"string","description":"Type of assignment target. Must be one of: 'allDevicesAssignmentTarget', 'allLicensedUsersAssignmentTarget', 'groupAssignmentTarget', 'exclusionGroupAssignmentTarget'.","description_kind":"markdown","required":true}},"nesting_mode":"set"},"description":"Assignments for the device configuration. Each assignment specifies the target group and schedule for script execution.","description_kind":"markdown","optional":true},"config_data_update_behavior":{"type":"string","description":"Update behavior for configuration data file updates. Possible values: `notConfigured`, `default`, `downloadOnly`, `installASAP`, `notifyOnly`, `installLater`.","description_kind":"markdown","required":true},"critical_update_behavior":{"type":"string","description":"Update behavior for critical updates. Possible values: `notConfigured`, `default`, `downloadOnly`, `installASAP`, `notifyOnly`, `installLater`. See [macOSSoftwareUpdateBehavior](https://learn.microsoft.com/en-us/graph/api/resources/intune-deviceconfig-macossoftwareupdatebehavior?view=graph-rest-beta).","description_kind":"markdown","required":true},"custom_update_time_windows":{"nested_type":{"attributes":{"end_day":{"type":"string","description":"End day of the time window. Possible values: `sunday`, `monday`, `tuesday`, `wednesday`, `thursday`, `friday`, `saturday`.","description_kind":"markdown","required":true},"end_time":{"type":"string","description":"End time of the window in `HH:MM:SS` format.","description_kind":"markdown","required":true},"start_day":{"type":"string","description":"Start day of the time window. Possible values: `sunday`, `monday`, `tuesday`, `wednesday`, `thursday`, `friday`, `saturday`.","description_kind":"markdown","required":true},"start_time":{"type":"string","description":"Start time of the window in `HH:MM:SS` format.","description_kind":"markdown","required":true}},"nesting_mode":"list"},"description":"Custom time windows when updates will be allowed or blocked. Maximum 20 elements. See [customUpdateTimeWindow](https://learn.microsoft.com/en-us/graph/api/resources/intune-deviceconfig-customupdatetimewindow?view=graph-rest-beta).","description_kind":"markdown","optional":true},"description":{"type":"string","description":"Optional description of the resource. Maximum length is 1500 characters.","description_kind":"markdown","optional":true,"computed":true},"display_name":{"type":"string","description":"The display name of the macOS software update configuration","description_kind":"markdown","required":true},"firmware_update_behavior":{"type":"string","description":"Update behavior for firmware updates. Possible values: `notConfigured`, `default`, `downloadOnly`, `installASAP`, `notifyOnly`, `installLater`.","description_kind":"markdown","required":true},"id":{"type":"string","description":"The unique identifier of the macOS software update configuration.","description_kind":"markdown","computed":true},"max_user_deferrals_count":{"type":"number","description":"The maximum number of times the system allows the user to postpone an update before it's installed. Supported values: 0 - 365.","description_kind":"markdown","optional":true,"computed":true},"priority":{"type":"string","description":"The scheduling priority for downloading and preparing the requested update. Possible values: `low`, `high`, `unknownFutureValue`. See [macOSPriority](https://learn.microsoft.com/en-us/graph/api/resources/intune-deviceconfig-macospriority?view=graph-rest-beta).","description_kind":"markdown","optional":true},"role_scope_tag_ids":{"type":["set","string"],"description":"List of Scope Tags for this Entity instance.","description_kind":"markdown","optional":true,"computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true},"update_schedule_type":{"type":"string","description":"Update schedule type. Possible values: `alwaysUpdate`, `updateDuringTimeWindows`, `updateOutsideOfTimeWindows`. See [macOSSoftwareUpdateScheduleType](https://learn.microsoft.com/en-us/graph/api/resources/intune-deviceconfig-macossoftwareupdatescheduletype?view=graph-rest-beta).","description_kind":"markdown","required":true}},"description":"Manages macOS software update configurations using the `/deviceManagement/deviceConfigurations` endpoint. This resource is used to manage the macOS software update configuration, this resource is now deprecated, since Apple have deprecated MDM-based software update workloads. Microsoft recommends you use DDM to install updates instead and can be implemented via the settings catalog. See [Manage macOS software updates using MDM-based policies in Microsoft Intune](https://learn.microsoft.com/en-us/intune/device-updates/apple/software-updates-macos) for details.","description_kind":"markdown"}},"microsoft365_graph_beta_device_management_managed_device_cleanup_rule":{"version":0,"block":{"attributes":{"description":{"type":"string","description":"Optional description of the resource. Maximum length is 1500 characters.","description_kind":"markdown","optional":true,"computed":true},"device_cleanup_rule_platform_type":{"type":"string","description":"The managed device platform for which the admin wants to create the device cleanup rule. Possible values are: `all`, `androidAOSP`, `androidDeviceAdministrator`, `androidDedicatedAndFullyManagedCorporateOwnedWorkProfile`, `chromeOS`, `androidPersonallyOwnedWorkProfile`, `ios`, `macOS`, `windows`, `windowsHolographic`, `unknownFutureValue`.","description_kind":"markdown","required":true},"device_inactivity_before_retirement_in_days":{"type":"number","description":"Number of days when the device has not contacted Intune before it gets automatically removed. Valid values are 30 to 270.","description_kind":"markdown","required":true},"display_name":{"type":"string","description":"The display name of the device cleanup rule.","description_kind":"markdown","required":true},"id":{"type":"string","description":"The unique identifier of the managed device cleanup rule.","description_kind":"markdown","computed":true},"last_modified_date_time":{"type":"string","description":"The date and time when the device cleanup rule was last modified. This property is read-only.","description_kind":"markdown","computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true}},"description":"Manages Managed Device Cleanup Rules in Microsoft Intune. Device cleanup rules define when the admin wants devices to be automatically removed from Intune management based on inactivity periods and platform types.","description_kind":"plain"}},"microsoft365_graph_beta_device_management_operation_approval_policy":{"version":0,"block":{"attributes":{"approver_group_ids":{"type":["set","string"],"description":"The Microsoft Entra ID (Azure AD) security group IDs for the approvers for the policy. This property is required when the policy is created, and is defined by the IT Admins to define the possible approvers for the policy.","description_kind":"markdown","required":true},"description":{"type":"string","description":"Optional description of the resource. Maximum length is 1500 characters.","description_kind":"markdown","optional":true,"computed":true},"display_name":{"type":"string","description":"Indicates the display name of the policy. Maximum length of the display name is 128 characters. This property is required when the policy is created, and is defined by the IT Admins to identify the policy.","description_kind":"markdown","required":true},"id":{"type":"string","description":"The unique identifier of the policy. This ID is assigned at when the policy is created. Read-only.","description_kind":"markdown","computed":true},"last_modified_date_time":{"type":"string","description":"Indicates the last DateTime that the policy was modified. The value cannot be modified and is automatically populated whenever values in the request are updated. Read-only.","description_kind":"markdown","computed":true},"policy_platform":{"type":"string","description":"Indicates the applicable platform for the policy. Possible values are:\n\n- **notApplicable**: Not applicable to any platform\n- **androidDeviceAdministrator**: Android device administrator platform\n- **androidEnterprise**: Android enterprise platform\n- **iOSiPadOS**: iOS/iPadOS platform\n- **macOS**: macOS platform\n- **windows10AndLater**: Windows 10 and later platform\n- **windows81AndLater**: Windows 8.1 and later platform\n- **windows10X**: Windows 10X platform\n- **unknownFutureValue**: Evolvable enumeration sentinel value. Do not use.","description_kind":"markdown","optional":true,"computed":true},"policy_set":{"nested_type":{"attributes":{"policy_platform":{"type":"string","description":"The policy platform for the policy set.","description_kind":"markdown","optional":true,"computed":true},"policy_type":{"type":"string","description":"The policy type for the policy set. Possible values are:\n\n- **unknown**: Default. Unknown policy type.\n- **deviceWipe**: Device wipe policy type.\n- **deviceRetire**: Device retire policy type.\n- **deviceDelete**: Device delete policy type.\n- **app**: Application policy type.\n- **script**: Script policy type.\n- **role**: Role policy type.\n- **unknownFutureValue**: Evolvable enumeration sentinel value. Do not use.\n- **tenantConfiguration**: Tenant configuration policy type.","description_kind":"markdown","required":true}},"nesting_mode":"single"},"description":"Indicates areas of the Intune UX that could support MAA UX for the current logged in IT Admin. This property is required, and is defined by the IT Admins in order to correctly show the expected experience.","description_kind":"markdown","required":true},"policy_type":{"type":"string","description":"The policy type for the OperationApprovalPolicy. Possible values are:\n\n- **unknown**: Default. Unknown policy type.\n- **deviceWipe**: Device wipe policy type.\n- **deviceRetire**: Device retire policy type.\n- **deviceDelete**: Device delete policy type.\n- **app**: Application policy type.\n- **script**: Script policy type.\n- **role**: Role policy type.\n- **unknownFutureValue**: Evolvable enumeration sentinel value. Do not use.\n- **tenantConfiguration**: Tenant configuration policy type.","description_kind":"markdown","optional":true,"computed":true},"timeouts":{"nested_type":{"attributes":{"create":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true},"delete":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.","description_kind":"plain","optional":true},"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.","description_kind":"plain","optional":true},"update":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).","description_kind":"plain","optional":true}},"nesting_mode":"single"},"description_kind":"plain","optional":true}},"description":"Manages Operation Approval Policies in Microsoft Intune.","description_kind":"plain"}},"microsoft365_g