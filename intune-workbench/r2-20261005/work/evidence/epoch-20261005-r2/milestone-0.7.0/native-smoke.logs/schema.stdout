},"is_in_multi_tenant_organization":{"type":"bool","description":"Identifies whether the partner organization is part of a multi-tenant organization with the local tenant.","description_kind":"markdown","computed":true},"is_service_provider":{"type":"bool","description":"Identifies whether the partner-specific configuration is a cloud service provider for your organization. **Important**: This field can only be set when using delegated (user) authentication. When using application (client credentials) authentication, this field must be omitted entirely - the API will reject requests with 403's that explicitly set this field to either `true` or `false`. This is a read-only computed field when using service principal authentication.","description_kind":"markdown","computed":true},"tenant_id":{"type":"string","description":"The tenant ID of the partner Microsoft Entra organization. This is a GUID that uniquely identifies the partner tenant.","description_kind":"markdown","required":true},"tenant_restrictions":{"nested_type":{"attributes":{"applications":{"nested_type":{"attributes":{"access_type":{"type":"string","description":"The access type. Possible values: `allowed`, `blocked`.","description_kind":"markdown","optional":true,"computed":true},"targets":{"nested_type":{"attributes":{"target":{"type":"string","description":"The unique identifier of the application. Can be an application GUID, or special values: `AllApplications`, `Office365`.","description_kind":"markdown","required":true},"target_type":{"type":"string","description":"The type of target. Must be `application`.","description_kind":"markdown","required":true}},"nesting_mode":"set"},"description":"The set of application targets to allow or block.","description_kind":"markdown","required":true}},"nesting_mode":"single"},"description":"Specifies whether to allow or block access for applications.","description_kind":"markdown","optional":true,"computed":true},"users_and_groups":{"nested_type":{"attributes":