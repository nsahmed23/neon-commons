tion":{"type":"string","description":"A two letter country code (ISO standard 3166), required for users that are assigned licenses.","description_kind":"markdown","computed":true},"user_principal_name":{"type":"string","description":"The user principal name (UPN) of the user.","description_kind":"markdown","computed":true},"user_type":{"type":"string","description":"A string value that can be used to classify user types in your directory (Member, Guest).","description_kind":"markdown","computed":true}},"nesting_mode":"list"},"description":"List of users matching the query criteria.","description_kind":"markdown","computed":true},"list_all":{"type":"bool","description":"Retrieve all users in the tenant. Conflicts with specific lookup attributes.","description_kind":"markdown","optional":true},"object_id":{"type":"string","description":"The unique object identifier of the user in Microsoft Entra ID. Conflicts with other lookup attributes.","description_kind":"markdown","optional":true},"odata_query":{"type":"string","description":"Custom OData filter expression for advanced queries (e.g., `accountEnabled eq true and userType eq 'Member'`). Conflicts with specific lookup attributes.","description_kind":"markdown","optional":true},"on_premises_distinguished_name":{"type":"string","description":"The on-premises Active Directory distinguished name (DN) of the user. Conflicts with other lookup attributes.","description_kind":"markdown","optional":true},"on_premises_immutable_id":{"type":"string","description":"The on-premises immutable ID (sourceAnchor) used to associate an on-premises Active Directory user account. Conflicts with other lookup attributes.","description_kind":"markdown","optional":true},"timeouts":{"nested_type":{"attributes":{"read":{"type":"string","description":"A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m