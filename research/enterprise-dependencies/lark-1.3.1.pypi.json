{"info":{"author":null,"author_email":"Erez Shinan <erezshin@gmail.com>","bugtrack_url":null,"classifiers":["Development Status :: 5 - Production/Stable","Intended Audience :: Developers","License :: OSI Approved :: MIT License","Programming Language :: Python :: 3","Topic :: Software Development :: Libraries :: Python Modules","Topic :: Text Processing :: General","Topic :: Text Processing :: Linguistic"],"description":"Lark is a modern general-purpose parsing library for Python.\nWith Lark, you can parse any context-free grammar, efficiently, with very little code.\nMain Features:\n- Builds a parse-tree (AST) automagically, based on the structure of the grammar\n- Earley parser\n- Can parse all context-free grammars\n- Full support for ambiguous grammars\n- LALR(1) parser\n- Fast and light, competitive with PLY\n- Can generate a stand-alone parser\n- CYK parser, for highly ambiguous grammars\n- EBNF grammar\n- Unicode fully supported\n- Automatic line & column tracking\n- Standard library of terminals (strings, numbers, names, etc.)\n- Import grammars from Nearley.js\n- Extensive test suite\n- And much more!\nSince version 1.2, only Python versions 3.8 and up are supported.\n","description_content_type":"text/markdown","docs_url":null,"download_url":null,"downloads":{"last_day":-1,"last_month":-1,"last_week":-1},"dynamic":["License-File"],"home_page":null,"keywords":"Earley, LALR, parser, parsing, ast","license":"MIT","license_expression":null,"license_files":["LICENSE"],"maintainer":null,"maintainer_email":null,"name":"lark","package_url":"https://pypi.org/project/lark/","platform":null,"project_url":"https://pypi.org/project/lark/","project_urls":{"Download":"https://github.com/lark-parser/lark/tarball/master","Homepage":"https://github.com/lark-parser/lark"},"provides_extra":["regex","nearley","atomic-cache","interegular"],"release_url":"https://pypi.org/project/lark/1.3.1/","requires_dist":["regex; extra == \"regex\"","js2py; extra == \"nearley\"","atomicwrites; extra == \"atomic-cache\"","interegular<0.4.0,>=0.3.1; extra == \"interegular\""],"requires_python":">=3.8","summary":"a modern parsing library","version":"1.3.1","yanked":false,"yanked_reason":null},"last_serial":32043128,"ownership":{"organization":null,"roles":[{"role":"Owner","user":"erez"}]},"urls":[{"comment_text":null,"core-metadata":{"sha256":"730d3f056045a9096bc0a65e4faccae53fe7f3634055174d4b8245cd19cb4cde"},"digests":{"blake2b_256":"823d14ce75ef66813643812f3093ab17e46d3a206942ce7376d31ec2d36229e7","md5":"cae52d2ef5e4113b4fa48773610f14bd","sha256":"c629b661023a014c37da873b4ff58a817398d12635d3bbb2c5a03be7fe5d1e12"},"downloads":-1,"filename":"lark-1.3.1-py3-none-any.whl","has_sig":false,"md5_digest":"cae52d2ef5e4113b4fa48773610f14bd","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.8","size":113151,"upload_time":"2025-10-27T18:25:54","upload_time_iso_8601":"2025-10-27T18:25:54.882451Z","url":"https://files.pythonhosted.org/packages/82/3d/14ce75ef66813643812f3093ab17e46d3a206942ce7376d31ec2d36229e7/lark-1.3.1-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"da3428fff3ab31ccff1fd4f6c7c7b0ceb2b6968d8ea4950663eadcb5720591a0","md5":"4cd79a5ca06dfc57c984a89a87ef938e","sha256":"b426a7a6d6d53189d318f2b6236ab5d6429eaf09259f1ca33eb716eed10d2905"},"downloads":-1,"filename":"lark-1.3.1.tar.gz","has_sig":false,"md5_digest":"4cd79a5ca06dfc57c984a89a87ef938e","packagetype":"sdist","python_version":"source","requires_python":">=3.8","size":382732,"upload_time":"2025-10-27T18:25:56","upload_time_iso_8601":"2025-10-27T18:25:56.653447Z","url":"https://files.pythonhosted.org/packages/da/34/28fff3ab31ccff1fd4f6c7c7b0ceb2b6968d8ea4950663eadcb5720591a0/lark-1.3.1.tar.gz","yanked":false,"yanked_reason":null}],"vulnerabilities":[]}
